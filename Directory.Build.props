<Project>
  <!-- Both apps build into one folder, like the published layout, so the widget finds the watcher next to it. -->
  <PropertyGroup>
    <!-- One version for everything that ships; the installer writes it to Settings → Apps. -->
    <Version>0.1.3</Version>
    <!-- Shown as the publisher in Settings → Apps and in each exe's file properties. -->
    <Company>Vibe-coded with Claude (AI-generated) · Jannis Jost</Company>
    <!-- Building a project on its own (not the solution) sets no configuration yet at this point. -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
