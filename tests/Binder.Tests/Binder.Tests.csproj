<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner (no test framework packages, see Dependencies policy).
       Compiles the non-UI sources directly; runs on Windows and Linux with "dotnet run" in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>Binder.Tests.Tests</StartupObject>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Keep test output out of the shared app folder (Directory.Build.props). -->
    <OutputPath>$(MSBuildProjectDirectory)\out\</OutputPath>
    <SatelliteResourceLanguages>en;de;fr</SatelliteResourceLanguages>
    <!-- The tests check the official releases' repository and keys (build/OfficialRelease.props). -->
    <BinderOfficialRelease>true</BinderOfficialRelease>
  </PropertyGroup>

  <Import Project="..\..\build\Updates.targets" />

  <ItemGroup>
