<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windowless: WinExe with no UI framework referenced. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Binder.Watcher</RootNamespace>
    <!-- Self-contained like the widget: debug builds share its output folder, whose hostfxr.dll makes a
         framework-dependent apphost treat that folder as the .NET install and fail ("You must install .NET"). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Product>Binder</Product>
    <AssemblyTitle>Binder game watcher</AssemblyTitle>
    <!-- The app's logo with an eye instead of the play mark (scripts\make-watcher-icon.ps1), for Task Manager. -->
    <ApplicationIcon>watcher.ico</ApplicationIcon>

    <!-- Native AOT is enabled by the publish script (-p:PublishAot=true): it needs the ILCompiler
         packs from nuget.org, which plain `dotnet build` shouldn't depend on. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- Kept small: it is the one Binder process that stays up while a game runs (budget ~3 MB, CLAUDE.md). -->
    <!-- No background GC thread: the watcher allocates almost nothing, and never while the game runs. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Its work is a few hundred API calls; size over speed (spec §15 d). -->
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <!-- Its logs keep exception messages only (e.Message), never stack traces, so it doesn't need their data. -->
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

</Project>
