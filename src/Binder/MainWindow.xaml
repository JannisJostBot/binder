<Window x:Class="Binder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:Binder"
        xmlns:v="using:Binder.Views"
        Title="Binder">
    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          CharacterReceived="OnCharacterReceived" KeyDown="OnRootKeyDown" PointerPressed="OnRootPointerPressed">
        <v:ShelfView x:Name="Shelf" />
        <v:DetailView x:Name="Detail" Visibility="Collapsed" />
        <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        <v:ImportView x:Name="ImportPage" Visibility="Collapsed" />
        <v:SetupView x:Name="SetupPage" Visibility="Collapsed" />
        <v:FreeSpaceView x:Name="FreeSpacePage" Visibility="Collapsed" />
        <v:GameModeView x:Name="GameModePage" Visibility="Collapsed" />
        <v:YearReviewView x:Name="YearReviewPage" Visibility="Collapsed" />

        <StackPanel VerticalAlignment="Bottom" Margin="16" Spacing="8">
            <!-- Notices (errors, Undo, …). On a solid backing so covers don't show through the InfoBar's
                 translucent fill. -->
            <Border x:Name="Toast" Visibility="Collapsed"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                <InfoBar x:Name="ToastBar" IsOpen="True" IsClosable="False" Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Name="ToastButton" Click="OnToastButton" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Border>

            <!-- Launch countdown (Launch → hide → return, step 2): a compact card floating above the bottom of the
                 panel with the game, the time left as a draining bar, and Keep open. The bar is one linear
                 animation run by the compositor (no per-frame work here); with animations off it steps once a
                 second with App's countdown, whose timer exists only while it counts. -->
            <Border x:Name="Countdown" Visibility="Collapsed" HorizontalAlignment="Center" MinWidth="320" MaxWidth="440"
                    Margin="0,0,0,8" Translation="0,0,32"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,12,12,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" AutomationProperties.AccessibilityView="Raw">
                            <FontIcon Glyph="&#xF5B0;" FontSize="12" Margin="2,0,0,0"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="CountdownTitle" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock x:Name="CountdownText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="KeepOpenButton" Grid.Column="2" Content="{x:Bind s:Strings.KeepOpen}" VerticalAlignment="Center"
                                Click="OnKeepOpenClick" ToolTipService.ToolTip="{x:Bind s:Strings.KeepOpenToolTip}"
                                AutomationProperties.Name="{x:Bind s:Strings.KeepOpenName}" />
                    </Grid>
                    <!-- Time left: a thin bar along the card's bottom edge, inside its rounded corners. -->
                    <Grid Grid.Row="1" Height="3" Margin="14,0,14,10" CornerRadius="1.5"
                          Background="{ThemeResource ControlStrokeColorSecondaryBrush}"
                          AutomationProperties.AccessibilityView="Raw">
                        <Rectangle x:Name="CountdownFill" Fill="{ThemeResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="CountdownScale" ScaleX="1" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
