<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Binder</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- WinUI 3 (Windows App SDK), unpackaged, with the runtime next to the exe: no MSIX, no Store, no
         system-wide Windows App Runtime install. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Program.Main runs the single-instance check before any UI loads (spec §5). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Native AOT for the published app (publish.ps1): fast start, no JIT. Everything is AOT-safe: x:Bind
         only, source-generated JSON and COM. -->
    <IsAotCompatible>true</IsAotCompatible>

    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <Product>Binder</Product>
    <AssemblyTitle>Binder</AssemblyTitle>

    <!-- The app's languages (Strings\Strings.*.resx); also keeps other languages' package resources out. -->
    <SatelliteResourceLanguages>en;de;fr</SatelliteResourceLanguages>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Approved in CLAUDE.md (Dependencies). Only the WinUI part of the Windows App SDK; not the AI, ML,
         widgets or search components the umbrella Microsoft.WindowsAppSDK package also brings. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
  </ItemGroup>

  <!-- The debug panel (Dev\, "--dev") is for Debug builds only: Release builds don't compile it at all, so none of it
       ships. publish.ps1 checks the published files for its marker and stops if it's there. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="Dev\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game mode's ids, files and restore result, shared with the watcher that applies and restores it. -->
    <Compile Include="..\Binder.Watcher\GameModeShared.cs" Link="Shared\GameModeShared.cs" />
    <Compile Include="..\Binder.Watcher\SessionLog.cs" Link="Shared\SessionLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\tray-dark.ico;Assets\tray-light.ico;Assets\tray-open-*.ico;Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <!-- Unpackaged publish leaves out the app's resource index, which holds the compiled XAML: without it every
       page fails to load. Publish it like any other output file. -->
  <Target Name="PublishAppPri" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutDir)$(TargetName).pri" RelativePath="$(TargetName).pri"
                             CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(OutDir)$(TargetName).pri')" />
    </ItemGroup>
  </Target>

</Project>
