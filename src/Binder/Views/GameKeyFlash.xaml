<Window x:Class="Binder.Views.GameKeyFlash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Binder.Views"
        Title="Binder">
    <!-- Game shortcuts (spec §26, board 35, A): the game's banner with its logo, centered above the taskbar where
         Game mode's pill shows, for the wait before it starts. A bar empties over the wait; Esc cancels. A number
         without a game gets the plain pill instead. Shown without focus; sized to this content once laid out. -->
    <!-- The window is transparent (TransparentBackdrop); Root's padding leaves room for the shadow. -->
    <Grid x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="28,20,28,32">
        <Grid x:Name="Body">
            <Grid.RenderTransform><TranslateTransform x:Name="BodyShift" /></Grid.RenderTransform>
            <Border x:Name="ShadowHost" IsHitTestVisible="False" />
            <Border x:Name="Surface" CornerRadius="8" BorderThickness="1" Background="{ThemeResource ToastSurfaceBrush}"
                    BorderBrush="{ThemeResource ToastStrokeBrush}" />

            <!-- The card: banner (art, logo or name) over a one-line strip. -->
            <Grid x:Name="Card" Width="360" Margin="1" CornerRadius="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <Grid x:Name="Banner" AutomationProperties.AccessibilityView="Raw">
                    <Image x:Name="Hero" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- No logo: the cover (or the generated one's icon) and the name, on the cover's color. -->
                    <StackPanel x:Name="NamePanel" Orientation="Horizontal" Spacing="16" Padding="20,0" VerticalAlignment="Center">
                        <Border x:Name="CoverBox" Width="66" Height="88" CornerRadius="8" Visibility="Collapsed">
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" MaxWidth="240"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="White" />
                    </StackPanel>
                    <v:BannerLogo x:Name="Logo" HorizontalAlignment="Center" VerticalAlignment="Center" MaxLogoHeight="72" MaxWidthShare="0.75" />
                </Grid>
                <Grid x:Name="Strip" Grid.Row="1" Padding="14,0,12,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Time left: a bar along the strip's top edge that empties over the wait. -->
                    <Grid x:Name="Track" Grid.ColumnSpan="3" Height="3" Margin="-14,0,-12,0" VerticalAlignment="Top"
                          Background="{ThemeResource ControlStrokeColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw">
                        <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="BarScale" ScaleX="1" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <Grid x:Name="CancelDot" Width="22" Height="22" VerticalAlignment="Center" Visibility="Collapsed"
                          AutomationProperties.AccessibilityView="Raw">
                        <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <FontIcon Glyph="&#xE711;" FontSize="9" />
                    </Grid>
                    <TextBlock x:Name="LineText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Assertive">
                        <Run x:Name="LineTitle" FontWeight="SemiBold" /><Run x:Name="LineDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <Border Style="{StaticResource KeyCap}" MinWidth="22">
                            <TextBlock x:Name="LetterKey" Style="{StaticResource KeyCapText}" HorizontalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource KeyCap}" MinWidth="22">
                            <TextBlock x:Name="NumberKey" Style="{StaticResource KeyCapText}" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Nothing on that number: Game mode's pill, with the number as its key. -->
            <Grid x:Name="Pill" Height="46" Margin="1" Padding="9,0,19,0" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="28" Height="28" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                    <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <TextBlock x:Name="PillKey" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="PillText" Grid.Column="1" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Assertive">
                    <Run x:Name="PillTitle" FontWeight="SemiBold" /><Run x:Name="PillDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
