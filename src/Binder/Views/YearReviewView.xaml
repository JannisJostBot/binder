<UserControl x:Class="Binder.Views.YearReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Binder"
             KeyDown="OnKeyDown">
    <!-- Year in review (spec §28, boards 41–43): one card at a time, paced by the user. The cards are built in code
         from the view model's CardSpec (YearReviewCards) and come in once (YearReviewMotion); nothing moves while a
         card sits still. -->
    <Grid Padding="16,16,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LeaveButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{x:Bind ViewModel.LeaveCommand}"
                    ToolTipService.ToolTip="{x:Bind s:Strings.BackToGames}" AutomationProperties.Name="{x:Bind s:Strings.BackToGames}" />
            <TextBlock Grid.Column="1" Text="{x:Bind s:Strings.YearInReview}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox x:Name="YearBox" Grid.Column="2" MinWidth="140" VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.YearChoices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedYearChoice, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind s:Strings.YirYear}" AutomationProperties.Name="{x:Bind s:Strings.YirYear}" />
        </Grid>

        <!-- Where you are: one segment per card (filled up to this one). They show position, they don't fill over time. -->
        <Grid x:Name="Progress" Grid.Row="1" Height="3" ColumnSpacing="4" AutomationProperties.AccessibilityView="Raw" />

        <!-- The card. Narrator hears each card's sentence when it comes in (YearReviewView.Announce). -->
        <Grid x:Name="CardHost" Grid.Row="2" />

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Command="{x:Bind ViewModel.BackCommand}" AutomationProperties.Name="{x:Bind s:Strings.Back}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    <TextBlock Text="{x:Bind s:Strings.Back}" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
            <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NextCommand}"
                    AutomationProperties.Name="{x:Bind ViewModel.NextLabel, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.NextLabel, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
