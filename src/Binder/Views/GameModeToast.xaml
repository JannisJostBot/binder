<Window x:Class="Binder.Views.GameModeToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:Binder"
        Title="Binder">
    <!-- Game mode's toast (board 23): a compact one-line pill, "Game mode on · 5 changes" after it applied and
         "Back to normal · 5 changes put back" after the restore; something that couldn't be changed or put back
         gets a larger card with room for the names and a way to the log. The same pill counts down a restart after
         a crash (spec §17). Centered above the taskbar like the
         volume flyout; the window is sized to this content once it has been laid out. The storyboard runs once
         when it shows (not at all when animations are off). -->
    <!-- The window itself is transparent (TransparentBackdrop); Root's padding leaves room for the shadow. -->
    <Grid x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="28,20,28,32">
        <Grid.Resources>
            <Storyboard x:Name="ShowStoryboard">
                <!-- The pill fades in first; then the dot pops in (a compositor scale, PopDot, so it stays sharp),
                     and then its icon moves: the check draws itself, or the gauge's needle sweeps up from off to
                     high (Windows' own speed glyphs). -->
                <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="StrokeDashOffset" From="8.5" To="0"
                                 BeginTime="0:0:0.35" Duration="0:0:0.45" EnableDependentAnimation="True">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OnGlyph" Storyboard.TargetProperty="Glyph">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="&#xEC48;" />
                    <DiscreteObjectKeyFrame KeyTime="0:0:0.4" Value="&#xEC49;" />
                    <DiscreteObjectKeyFrame KeyTime="0:0:0.6" Value="&#xEC4A;" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetName="BodyShift" Storyboard.TargetProperty="Y" From="6" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <Grid x:Name="Body">
            <Grid.RenderTransform><TranslateTransform x:Name="BodyShift" /></Grid.RenderTransform>
            <!-- The soft shadow under the surface (a composition drop shadow, drawn once; none in high contrast). -->
            <Border x:Name="ShadowHost" IsHitTestVisible="False" />
            <!-- The surface: fully round ends on the 48 px pill, the same radius on the card. -->
            <Border x:Name="Surface" CornerRadius="24" BorderThickness="1" Background="{ThemeResource ToastSurfaceBrush}"
                    BorderBrush="{ThemeResource ToastStrokeBrush}" />
            <!-- The melt (ToastMelt): the drops and the surface they melt into, then the icons they carry, between
                 the surface and the text. Empty when the pill shows without it (animations off, high contrast). -->
            <Canvas x:Name="MeltHost" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <Canvas x:Name="GlyphHost" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <Grid x:Name="Inner" Margin="1">

            <!-- The pill: a small round dot (accent while game mode is on, neutral with a green check once Windows
                 is back to normal) and one line of text. -->
            <Grid x:Name="Pill" Height="46" Padding="9,0,19,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="Dot" Width="28" Height="28" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                    <Ellipse x:Name="DotFill" Fill="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" />
                    <!-- On: a gauge. Back to normal: a check that draws itself. -->
                    <FontIcon x:Name="OnGlyph" Glyph="&#xEC4A;" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <!-- With the melt: a gauge whose needle really sweeps. -->
                    <Viewbox x:Name="Gauge" Width="16" Height="16" Visibility="Collapsed">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 4,17 A 8,8 0 1 1 20,17" Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path x:Name="Needle" Data="M 12,17 L 12,9.5" Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <Path x:Name="Mark" Data="M 9,14.5 L 12.5,18 L 19.5,10.5" StrokeThickness="2" StrokeDashArray="8 10"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="LineText" Grid.Column="1" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Assertive">
                    <Run x:Name="LineTitle" FontWeight="SemiBold" /><Run x:Name="LineDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <!-- With the melt: the same line in parts, so the count can roll up as each change lands. -->
                <StackPanel x:Name="MeltLine" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Assertive">
                    <TextBlock x:Name="MeltTitle" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                    <TextBlock x:Name="MeltSep" Style="{StaticResource BodyTextBlockStyle}" Margin="4,0,4,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="MeltDetail" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Restart after a crash (spec §17): the same pill with a caution dot, "[Game] crashed · Restarting in
                 5 s", Cancel, and a thin bar along the bottom edge that drains until the game starts again. -->
            <Grid x:Name="RestartPill" Height="46" Padding="9,0,7,0" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="RestartDot" Width="28" Height="28" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                    <Ellipse Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Grid>
                <TextBlock x:Name="RestartText" Grid.Column="1" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Assertive">
                    <Run x:Name="RestartTitle" FontWeight="SemiBold" /><Run x:Name="RestartDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <Button x:Name="RestartCancel" Grid.Column="2" VerticalAlignment="Center" CornerRadius="16" Padding="12,4"
                        />
                <!-- Time left, inside the round ends. -->
                <Grid Grid.ColumnSpan="3" Height="3" Margin="22,0,22,4" VerticalAlignment="Bottom" CornerRadius="1.5"
                      Background="{ThemeResource ControlStrokeColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw">
                    <Rectangle Fill="{ThemeResource SystemFillColorCautionBrush}" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="RestartScale" ScaleX="1" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Grid>

            <!-- Something couldn't be changed or put back: a card with the whole message and the way to the log. -->
            <Grid x:Name="Card" Width="378" Padding="12,12,10,16" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Width="28" Height="28" Margin="0,2,0,0" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                    <Ellipse Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="!" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,0,0,2" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="4" Padding="0,5,0,0">
                    <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                        Width="32" Height="32" VerticalAlignment="Top" Click="OnCloseClick" />
                <Button x:Name="DetailsButton" Grid.Row="1" Grid.Column="1" Click="OnDetailsClick"
                        Visibility="Collapsed" />
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
