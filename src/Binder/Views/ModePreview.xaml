<UserControl x:Class="Binder.Views.ModePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
    <!-- A small picture of the desktop in each display mode: the wallpaper, an app window, the taskbar and the shelf.
         Flyout: the shelf opens above its tray icon (ringed), in front of the window. On the desktop: the shelf sits
         on the wallpaper next to desktop icons, behind the window. Drawn in a fixed 200 x 120 space and scaled to
         fit. Static shapes only; theme brushes follow Windows live (light/dark, accent, high contrast). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- The covers: muted colors like the generated ones, the first in the accent color. -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CoverA" Color="#6A7B8C" />
                    <SolidColorBrush x:Key="CoverB" Color="#8A6A5A" />
                    <SolidColorBrush x:Key="CoverC" Color="#5A7A62" />
                    <SolidColorBrush x:Key="CoverD" Color="#7A6A8A" />
                    <SolidColorBrush x:Key="CoverE" Color="#8A7A5A" />
                    <SolidColorBrush x:Key="Wallpaper" Color="{ThemeResource SystemAccentColorDark2}" />
                    <SolidColorBrush x:Key="DesktopIcon" Color="#D8E0E8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CoverA" Color="#8496A8" />
                    <SolidColorBrush x:Key="CoverB" Color="#A88472" />
                    <SolidColorBrush x:Key="CoverC" Color="#74967C" />
                    <SolidColorBrush x:Key="CoverD" Color="#9684A8" />
                    <SolidColorBrush x:Key="CoverE" Color="#A89672" />
                    <SolidColorBrush x:Key="Wallpaper" Color="{ThemeResource SystemAccentColorLight1}" />
                    <SolidColorBrush x:Key="DesktopIcon" Color="#F3F5F8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CoverA" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CoverB" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CoverC" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CoverD" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CoverE" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="Wallpaper" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DesktopIcon" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="Cover" TargetType="Border">
                <Setter Property="Height" Value="13" />
                <Setter Property="CornerRadius" Value="1.5" />
            </Style>
            <Style x:Key="AppWindow" TargetType="Border">
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
            </Style>
            <!-- An app window's content: a title bar with its three buttons at the right. -->
            <ControlTemplate x:Key="WindowContent" TargetType="ContentControl">
                <Border Height="8" VerticalAlignment="Top" BorderThickness="0,0,0,0.5"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0" Spacing="3">
                        <Border Width="3.5" Height="1" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Border Width="3.5" Height="3.5" BorderThickness="0.5" BorderBrush="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Border Width="3.5" Height="3.5" CornerRadius="0.5" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Width" Value="56" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
            <!-- The shelf: a title, the search box and nine covers. -->
            <ControlTemplate x:Key="MiniShelf" TargetType="ContentControl">
                <StackPanel Spacing="3">
                    <Border Width="18" Height="3" HorizontalAlignment="Left" CornerRadius="1"
                            Background="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Border Height="5" CornerRadius="1" Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderThickness="0,0,0,0.5" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Grid ColumnSpacing="2.5" RowSpacing="2.5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Cover}" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border Style="{StaticResource Cover}" Grid.Column="1" Background="{ThemeResource CoverA}" />
                        <Border Style="{StaticResource Cover}" Grid.Column="2" Background="{ThemeResource CoverB}" />
                        <Border Style="{StaticResource Cover}" Grid.Row="1" Background="{ThemeResource CoverC}" />
                        <Border Style="{StaticResource Cover}" Grid.Row="1" Grid.Column="1" Background="{ThemeResource CoverD}" />
                        <Border Style="{StaticResource Cover}" Grid.Row="1" Grid.Column="2" Background="{ThemeResource CoverE}" />
                        <Border Style="{StaticResource Cover}" Grid.Row="2" Background="{ThemeResource CoverB}" />
                        <Border Style="{StaticResource Cover}" Grid.Row="2" Grid.Column="1" Background="{ThemeResource CoverE}" />
                        <Border Style="{StaticResource Cover}" Grid.Row="2" Grid.Column="2" Background="{ThemeResource CoverA}" />
                    </Grid>
                </StackPanel>
            </ControlTemplate>
            <Style x:Key="TaskbarIcon" TargetType="Border">
                <Setter Property="Width" Value="5" />
                <Setter Property="Height" Value="5" />
                <Setter Property="CornerRadius" Value="1" />
                <Setter Property="Background" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="DesktopIconStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="1.5" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="200" Height="120" CornerRadius="6" Background="{ThemeResource Wallpaper}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
            </Grid.RowDefinitions>

            <!-- Flyout: an app window, the shelf opened above the tray icon, in front of everything. -->
            <Grid x:Name="FlyoutScene">
                <Border Style="{StaticResource AppWindow}" Margin="10,9,72,14">
                    <ContentControl Template="{StaticResource WindowContent}" />
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,8,7,3">
                    <ContentControl Template="{StaticResource MiniShelf}" />
                </Border>
            </Grid>

            <!-- On the desktop: desktop icons, the shelf docked on the wallpaper, an app window in front of it. -->
            <Grid x:Name="DesktopScene" Visibility="Collapsed">
                <StackPanel Margin="8,8,0,0" Spacing="7" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Style="{StaticResource DesktopIconStyle}">
                        <Border Width="9" Height="9" CornerRadius="1.5" Background="{ThemeResource DesktopIcon}" />
                        <Border Width="11" Height="1.5" CornerRadius="0.5" Background="{ThemeResource DesktopIcon}" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource DesktopIconStyle}">
                        <Border Width="9" Height="9" CornerRadius="1.5" Background="{ThemeResource DesktopIcon}" />
                        <Border Width="11" Height="1.5" CornerRadius="0.5" Background="{ThemeResource DesktopIcon}" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource DesktopIconStyle}">
                        <Border Width="9" Height="9" CornerRadius="1.5" Background="{ThemeResource DesktopIcon}" />
                        <Border Width="11" Height="1.5" CornerRadius="0.5" Background="{ThemeResource DesktopIcon}" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource Panel}" Margin="0,6,7,6">
                    <ContentControl Template="{StaticResource MiniShelf}" />
                </Border>
                <Border Style="{StaticResource AppWindow}" Margin="30,18,40,12">
                    <ContentControl Template="{StaticResource WindowContent}" />
                </Border>
            </Grid>

            <!-- Taskbar: centered icons, the tray on the right. -->
            <Border Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderThickness="0,0.5,0,0" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                        <Border Style="{StaticResource TaskbarIcon}" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border Style="{StaticResource TaskbarIcon}" />
                        <Border Style="{StaticResource TaskbarIcon}" />
                        <Border Style="{StaticResource TaskbarIcon}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,7,0" Spacing="4">
                        <!-- The shelf's tray icon; in the flyout picture ringed, since that's where it opens. -->
                        <Border x:Name="TrayRing" Width="8" Height="8" CornerRadius="2" BorderThickness="0.75"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                            <Border x:Name="TrayIcon" Width="4" Height="4" CornerRadius="1"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Border>
                        <Border Width="14" Height="3" CornerRadius="1" VerticalAlignment="Center"
                                Background="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
