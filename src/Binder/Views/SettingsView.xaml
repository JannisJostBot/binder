<UserControl x:Class="Binder.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Binder"
             xmlns:v="using:Binder.Views">
    <UserControl.Resources>
        <Style x:Key="SourceCheck" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!--
        Board 19: one card per setting, grouped as in Windows Settings. A second line shows only when it says
        something about the state (12 imported, 72 games, a shortcut that's taken); explanations are tooltips, and
        rarely used parts open from their card (Disclosure).
    -->
    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="0,20,0,24">
            <!-- Header -->
            <Grid Margin="16,0,20,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{x:Bind ViewModel.BackCommand}"
                        ToolTipService.ToolTip="{x:Bind s:Strings.BackToGamesEsc}" AutomationProperties.Name="{x:Bind s:Strings.BackToGames}" />
                <TextBlock Grid.Column="1" Text="{x:Bind s:Strings.Settings}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            </Grid>

            <!-- Opening Binder (board 9) -->
            <TextBlock Style="{StaticResource GroupLabel}" Margin="20,20,20,12" Text="{x:Bind s:Strings.GroupOpening}" />
            <Border x:Name="ModeCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7C4;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.ShowItAs}" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.ModeText, Mode=OneWay}" />
                    </StackPanel>
                    <Button x:Name="ModeChevron" Grid.Column="2" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="ModeBody" Style="{StaticResource SettingCardBody}">
                <RadioButtons MaxColumns="2" AutomationProperties.Name="{x:Bind s:Strings.ShowItAs}"
                              SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                    <RadioButton Tag="Flyout" ToolTipService.ToolTip="{x:Bind s:Strings.ModeFlyoutToolTip}">
                        <StackPanel Width="170">
                            <v:ModePreview HorizontalAlignment="Left" Width="150" Height="82" Margin="0,2,0,8" />
                            <TextBlock Text="{x:Bind s:Strings.ModeFlyout}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Tag="Desktop" ToolTipService.ToolTip="{x:Bind s:Strings.ModeDesktopToolTip}">
                        <StackPanel Width="170">
                            <v:ModePreview HorizontalAlignment="Left" Width="150" IsDesktop="True" Height="82" Margin="0,2,0,8" />
                            <TextBlock Text="{x:Bind s:Strings.ModeDesktop}" />
                        </StackPanel>
                    </RadioButton>
                </RadioButtons>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE765;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.KeyboardShortcut}" />
                        <TextBlock Style="{StaticResource RowDetail}" Visibility="{x:Bind ViewModel.HotkeyTaken, Mode=OneWay}" Text="{x:Bind s:Strings.HotkeyTaken}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" Style="{StaticResource RowCombo}" AutomationProperties.Name="{x:Bind s:Strings.KeyboardShortcut}"
                              ItemsSource="{x:Bind ViewModel.HotkeyLabels}" SelectedIndex="{x:Bind ViewModel.HotkeyIndex, Mode=TwoWay}"
                              ToolTipService.ToolTip="{x:Bind ViewModel.HotkeyToolTip, Mode=OneWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="{x:Bind s:Strings.TrayIconToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xEA8F;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.TrayIcon}" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.TrayIcon, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="{x:Bind s:Strings.TrayIcon}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="{x:Bind s:Strings.ClickAwayToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7C9;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.ClickAway}" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CloseOnClickAway, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="{x:Bind s:Strings.ClickAway}" />
                </Grid>
            </Border>

            <Border x:Name="StayReadyCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="{x:Bind s:Strings.StayReadyToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE945;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.StayReady}" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.StayReadyText, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.StayReady, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="{x:Bind s:Strings.StayReady}" />
                    <Button x:Name="StayReadyChevron" Grid.Column="3" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="StayReadyBody" Style="{StaticResource SettingCardBody}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.WhileClosed}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource RowCombo}" AutomationProperties.Name="{x:Bind s:Strings.WhileClosed}"
                                  SelectedIndex="{x:Bind ViewModel.KeepLoadedIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.KeepLoadedEnabled, Mode=OneWay}">
                            <ComboBoxItem Content="{x:Bind s:Strings.OpenFaster}" Tag="Fast" />
                            <ComboBoxItem Content="{x:Bind s:Strings.UseLessMemory}" Tag="Light" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.KeepLoadedDetail, Mode=OneWay}" Style="{StaticResource RowDetail}" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7E8;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.StartWithWindows}" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="{x:Bind s:Strings.StartWithWindows}" />
                </Grid>
            </Border>

            <!-- When a game starts -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="{x:Bind s:Strings.GroupGameStarts}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE916;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.HideBinder}" />
                    <ComboBox Grid.Column="2" Style="{StaticResource RowCombo}"
                              AutomationProperties.Name="{x:Bind s:Strings.HideDelay}" SelectedIndex="{x:Bind ViewModel.DelayIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Bind s:Strings.Instantly}" Tag="0" />
                        <ComboBoxItem Content="{x:Bind s:Strings.After5s}" Tag="5" />
                        <ComboBoxItem Content="{x:Bind s:Strings.After10s}" Tag="10" />
                        <ComboBoxItem Content="{x:Bind s:Strings.After30s}" Tag="30" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="{x:Bind s:Strings.ComeBackToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7A7;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.ComeBack}" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ComeBackOnClose, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="{x:Bind s:Strings.ComeBack}" />
                </Grid>
            </Border>
            <!-- Game mode (spec §11): its own page -->
            <Button Style="{StaticResource SettingLinkCard}" Command="{x:Bind ViewModel.GameModeCommand}" AutomationProperties.Name="{x:Bind s:Strings.GameModeSettings}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7FC;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GameMode}" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.GameModeText, Mode=OneWay}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>

            <!-- Shelf (board 9) -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="{x:Bind s:Strings.GroupShelf}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xECA5;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.CoverSize}" />
                    <ComboBox Grid.Column="2" Style="{StaticResource RowCombo}"
                              AutomationProperties.Name="{x:Bind s:Strings.CoverSize}" SelectedIndex="{x:Bind ViewModel.DensityIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Bind s:Strings.CoverSmall}" Tag="Small" />
                        <ComboBoxItem Content="{x:Bind s:Strings.CoverMedium}" Tag="Medium" />
                        <ComboBoxItem Content="{x:Bind s:Strings.CoverLarge}" Tag="Large" />
                        <ComboBoxItem Content="{x:Bind s:Strings.CoverList}" Tag="List" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="{x:Bind s:Strings.WeekCardToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE9D2;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.ShowWeek}" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShowWeeklySummary, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="{x:Bind s:Strings.ShowWeek}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="{x:Bind s:Strings.ShinyToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE734;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.Shiny}" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShinyFavorites, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="{x:Bind s:Strings.Shiny}" />
                </Grid>
            </Border>

            <!-- Library -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="{x:Bind s:Strings.GroupLibrary}" />
            <Border x:Name="SourcesCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE8F1;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GameSources}" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.LibraryText, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{x:Bind s:Strings.Refresh}" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind s:Strings.RefreshLibrary}" ToolTipService.ToolTip="{x:Bind s:Strings.RefreshToolTip}" />
                    <Button x:Name="SourcesChevron" Grid.Column="3" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="SourcesBody" Style="{StaticResource SettingCardBody}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <CheckBox IsChecked="{x:Bind ViewModel.SteamEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Steam" />
                        <CheckBox IsChecked="{x:Bind ViewModel.EpicEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Epic Games" />
                        <CheckBox IsChecked="{x:Bind ViewModel.GogEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="GOG" />
                        <CheckBox IsChecked="{x:Bind ViewModel.EaEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="EA app" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <CheckBox IsChecked="{x:Bind ViewModel.UbisoftEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Ubisoft Connect" />
                        <CheckBox IsChecked="{x:Bind ViewModel.XboxEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="{x:Bind s:Strings.XboxAppGamePass}" />
                        <CheckBox IsChecked="{x:Bind ViewModel.RockstarEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Rockstar Games"
                                  AutomationProperties.Name="Rockstar Games Launcher" />
                        <CheckBox IsChecked="{x:Bind ViewModel.HytaleEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Hytale"
                                  AutomationProperties.Name="Hytale Launcher" />
                        <CheckBox IsChecked="{x:Bind ViewModel.ShortcutsEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="{x:Bind s:Strings.DesktopShortcuts}"
                                  AutomationProperties.Name="{x:Bind s:Strings.ImportedShortcuts}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ShortcutsCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE71B;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.DesktopShortcuts}" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.ShortcutsText, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{x:Bind s:Strings.ImportEllipsis}" Command="{x:Bind ViewModel.ImportCommand}" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind s:Strings.ImportShortcuts}"
                            ToolTipService.ToolTip="{x:Bind s:Strings.ImportToolTip}" />
                    <Button x:Name="ShortcutsChevron" Grid.Column="3" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="ShortcutsBody" Style="{StaticResource SettingCardBody}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                               Text="{x:Bind s:Strings.RestoreShortcutsText}" />
                    <Button Grid.Column="1" Content="{x:Bind s:Strings.Restore}" Command="{x:Bind ViewModel.RestoreCommand}" IsEnabled="{x:Bind ViewModel.CanRestoreShortcuts, Mode=OneWay}" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind s:Strings.RestoreShortcuts}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE710;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.AddGame}" />
                    <Button Grid.Column="2" Content="{x:Bind s:Strings.Browse}" Command="{x:Bind ViewModel.AddGameCommand}" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind s:Strings.AddGame}" ToolTipService.ToolTip="{x:Bind s:Strings.BrowseToolTip}" />
                </Grid>
            </Border>

            <Border x:Name="HiddenCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xED1A;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.HiddenGames}" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.HiddenCountText, Mode=OneWay}" />
                    </StackPanel>
                    <Button x:Name="HiddenChevron" Grid.Column="2" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="HiddenBody" Style="{StaticResource SettingCardBody}" Padding="52,0,16,0">
                <StackPanel>
                    <StackPanel x:Name="HiddenList" AutomationProperties.Name="{x:Bind s:Strings.HiddenGames}" />
                    <TextBlock Visibility="{x:Bind ViewModel.NoHiddenGames, Mode=OneWay}" Margin="0,14" TextWrapping="Wrap" Style="{StaticResource RowDetail}" TextTrimming="None"
                               Text="{x:Bind s:Strings.NoHiddenGames}" />
                </StackPanel>
            </Border>

            <!-- Storage (spec §12) -->
            <Button Style="{StaticResource SettingLinkCard}" Command="{x:Bind ViewModel.FreeSpaceCommand}" AutomationProperties.Name="{x:Bind s:Strings.FreeUpSpace}"
                    ToolTipService.ToolTip="{x:Bind s:Strings.FreeUpSpaceToolTip}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xEDA2;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.FreeUpSpace}" />
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>

            <!-- Window -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="{x:Bind s:Strings.GroupWindow}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE8A9;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.Position}" />
                        <TextBlock Style="{StaticResource RowDetail}" Visibility="{x:Bind ViewModel.PositionIsFree, Mode=OneWay}"
                                   Text="{x:Bind s:Strings.PositionFreeHint}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" Style="{StaticResource RowCombo}"
                              AutomationProperties.Name="{x:Bind s:Strings.Position}" SelectedIndex="{x:Bind ViewModel.PositionIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Bind s:Strings.LeftEdge}" Tag="Left" />
                        <ComboBoxItem Content="{x:Bind s:Strings.RightEdge}" Tag="Right" />
                        <ComboBoxItem Content="{x:Bind s:Strings.PositionFree}" Tag="Free" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}" Visibility="{x:Bind ViewModel.ShowScreens, Mode=OneWay}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="{x:Bind s:Strings.ScreenToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7F4;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.Screen}" />
                    <ComboBox Grid.Column="2" Style="{StaticResource RowCombo}" AutomationProperties.Name="{x:Bind s:Strings.Screen}"
                              ItemsSource="{x:Bind ViewModel.Screens, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedScreen, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="{x:Bind s:Strings.DesktopLayerToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE81E;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.DesktopLayer}" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.StayOnDesktop, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="{x:Bind s:Strings.DesktopLayer}" />
                </Grid>
            </Border>
            <!-- Advanced (spec §14): where launchers' games and Steam's pictures are found. Starts closed; the
                 launchers' entries are drawn in code (SettingsView.xaml.cs). -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="{x:Bind s:Strings.GroupAdvanced}" />
            <Border x:Name="SourcePathsCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="{x:Bind s:Strings.SourcePathsIntro}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE8B7;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.SourcePaths}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.SourcePathsText, Mode=OneWay}" />
                    </StackPanel>
                    <Button x:Name="SourcePathsChevron" Grid.Column="2" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="SourcePathsBody" Style="{StaticResource SettingCardBody}" Padding="52,12,16,16">
                <StackPanel Spacing="12">
                    <!-- Laid out like Free up space's map title: a heading with its (i), the line under it. -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind s:Strings.InfoHowItWorks}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Button x:Name="SourcePathsHelpButton" Style="{StaticResource IconButton}" Content="&#xE946;" Click="OnSourcePathsHelpClick"
                                    ToolTipService.ToolTip="{x:Bind s:Strings.InfoHowItWorks}" AutomationProperties.Name="{x:Bind s:Strings.InfoHowItWorks}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind s:Strings.SourcePathsIntro}" />
                    </StackPanel>
                    <TeachingTip x:Name="SourcePathsHelpTip" Target="{x:Bind SourcePathsHelpButton}" Title="{x:Bind s:Strings.InfoHowItWorks}"
                                 IsLightDismissEnabled="True" PreferredPlacement="Bottom">
                        <StackPanel Spacing="8">
                            <TextBlock TextWrapping="Wrap" Text="{x:Bind s:Strings.HelpSourcePaths1}" />
                            <TextBlock TextWrapping="Wrap" Text="{x:Bind s:Strings.HelpSourcePaths2}" />
                            <TextBlock TextWrapping="Wrap" Text="{x:Bind s:Strings.HelpSourcePaths3}" />
                            <TextBlock TextWrapping="Wrap" Text="{x:Bind s:Strings.HelpSourcePaths4}" />
                        </StackPanel>
                    </TeachingTip>
                    <StackPanel x:Name="SourcePathsList" Spacing="20" AutomationProperties.Name="{x:Bind s:Strings.SourcePaths}" />
                    <Button HorizontalAlignment="Left" Content="{x:Bind s:Strings.ResetAll}" IsEnabled="{x:Bind ViewModel.CanResetAllPaths, Mode=OneWay}"
                            Click="OnResetAllPathsClick" />
                </StackPanel>
            </Border>

            <HyperlinkButton Margin="8,24,20,0" Content="{x:Bind s:Strings.RunSetupAgain}" Command="{x:Bind ViewModel.SetupCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
