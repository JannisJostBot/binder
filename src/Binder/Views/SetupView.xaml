<UserControl x:Class="Binder.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Binder"
             xmlns:v="using:Binder.Views">
    <UserControl.Resources>
        <Style x:Key="StepLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="28">
        <!-- Step 1: launchers found -->
        <Grid x:Name="Step1" RowSpacing="18" Visibility="{x:Bind ViewModel.IsStep1, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource StepLabel}" Text="{x:Bind s:Strings.Step1}" />
                <TextBlock Style="{StaticResource StepTitle}" Text="{x:Bind ViewModel.FoundTitle, Mode=OneWay}" />
                <!-- Spec §22 d: the user's own number, once, when there's one to say. -->
                <TextBlock Style="{StaticResource StepText}" Text="{x:Bind ViewModel.NotInStartText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasNotInStart, Mode=OneWay}" />
                <CheckBox Margin="0,6,0,0" Content="{x:Bind s:Strings.StartMenuGames}" IsChecked="{x:Bind ViewModel.AddToStart, Mode=TwoWay}"
                          Visibility="{x:Bind ViewModel.ShowAddToStart, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind s:Strings.StartMenuGamesToolTip}"
                          AutomationProperties.Name="{x:Bind s:Strings.StartMenuGames}" />
                <TextBlock Style="{StaticResource StepText}"
                           Text="{x:Bind s:Strings.SetupStep1Text}" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel x:Name="LauncherList" Margin="0,6" AutomationProperties.Name="{x:Bind s:Strings.Launchers}" />
                    <TextBlock Margin="0,14" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.NothingFound, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind s:Strings.SetupNothingFound}" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Button HorizontalAlignment="Left" Content="{x:Bind s:Strings.SkipSetup}" Command="{x:Bind ViewModel.SkipCommand}" />
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Padding="22,6" Content="{x:Bind s:Strings.Next}"
                        Command="{x:Bind ViewModel.NextCommand}" AutomationProperties.Name="{x:Bind s:Strings.Next}" />
            </Grid>
        </Grid>

        <!-- Step 2: tidy the desktop -->
        <Grid x:Name="Step2" RowSpacing="14" Visibility="{x:Bind ViewModel.IsStep2, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource StepLabel}" Text="{x:Bind s:Strings.Step2}" />
                <TextBlock Style="{StaticResource StepTitle}" Text="{x:Bind s:Strings.SetupStep2Title}" />
                <TextBlock Style="{StaticResource StepText}"
                           Text="{x:Bind s:Strings.SetupStep2Text}" />
            </StackPanel>
            <v:ImportView x:Name="Picker" Grid.Row="1" />
            <TextBlock Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid Grid.Row="3">
                <Button HorizontalAlignment="Left" Content="{x:Bind s:Strings.Back}" Command="{x:Bind ViewModel.BackToStep1Command}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{x:Bind s:Strings.NotNow}" Command="{x:Bind ViewModel.NotNowCommand}" />
                    <Button Style="{StaticResource AccentButtonStyle}" Padding="22,6" Command="{x:Bind ViewModel.MoveCommand}"
                            Content="{x:Bind ViewModel.MoveText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanMove, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Step 3: how it opens -->
        <Grid x:Name="Step3" RowSpacing="18" Visibility="{x:Bind ViewModel.IsStep3, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource StepLabel}" Text="{x:Bind s:Strings.Step3}" />
                <TextBlock Style="{StaticResource StepTitle}" Text="{x:Bind s:Strings.SetupStep3Title}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="14">
                    <!-- What step 2's move did (in the page, so nothing covers Done). -->
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Success" Visibility="{x:Bind ViewModel.HasImportResult, Mode=OneWay}"
                             Title="{x:Bind ViewModel.ImportTitle, Mode=OneWay}" Message="{x:Bind ViewModel.ImportDetail, Mode=OneWay}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton GroupName="SetupMode" AutomationProperties.Name="{x:Bind s:Strings.ModeFlyout}" IsChecked="{x:Bind ViewModel.Flyout, Mode=TwoWay}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <StackPanel>
                                <v:ModePreview Height="100" Margin="0,0,0,10" />
                                <TextBlock Text="{x:Bind s:Strings.ModeFlyout}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind s:Strings.SetupFlyoutText}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" GroupName="SetupMode" AutomationProperties.Name="{x:Bind s:Strings.ModeDesktop}" IsChecked="{x:Bind ViewModel.Desktop, Mode=TwoWay}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <StackPanel>
                                <v:ModePreview IsDesktop="True" Height="100" Margin="0,0,0,10" />
                                <TextBlock Text="{x:Bind s:Strings.ModeDesktop}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind s:Strings.SetupDesktopText}" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.StartWithWindows}" />
                                <ToggleSwitch Style="{StaticResource RowSwitch}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind s:Strings.StartWithWindows}" />
                            </Grid>
                            <Border Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.KeyboardShortcut}" />
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind ViewModel.HotkeyText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="{x:Bind s:Strings.SetupWhereTitle}"
                             Message="{x:Bind s:Strings.SetupWhereText}" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2">
                <Button HorizontalAlignment="Left" Content="{x:Bind s:Strings.Back}" Command="{x:Bind ViewModel.BackToStep2Command}" />
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Padding="22,6" Content="{x:Bind s:Strings.Next}"
                        Command="{x:Bind ViewModel.ToStep4Command}" AutomationProperties.Name="{x:Bind s:Strings.Next}" />
            </Grid>
        </Grid>

        <!-- Step 4: Game mode, with its admin helper (one UAC prompt, only for "All items"). Opens on Off. -->
        <Grid x:Name="Step4" RowSpacing="18" Visibility="{x:Bind ViewModel.IsStep4, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource StepLabel}" Text="{x:Bind s:Strings.Step4}" />
                <TextBlock Style="{StaticResource StepTitle}" Text="{x:Bind s:Strings.SetupStep4Title}" />
                <TextBlock Style="{StaticResource StepText}" Text="{x:Bind s:Strings.SetupStep4Text}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="14">
                    <InfoBar IsOpen="{x:Bind ViewModel.AllowDeclined, Mode=OneWay}" IsClosable="False" Severity="Warning"
                             Message="{x:Bind s:Strings.SetupGmDeclined}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.AllowFailed, Mode=OneWay}" IsClosable="False" Severity="Error"
                             Title="{x:Bind s:Strings.SetupGmCouldntAllow}" Message="{x:Bind ViewModel.AllowError, Mode=OneWay}" />

                    <!-- Card has no vertical padding (it's made for rows with dividers); these hold free content. -->
                    <Border Style="{StaticResource Card}" Margin="0" Padding="16,10,16,12">
                        <StackPanel Spacing="4" AutomationProperties.Name="{x:Bind s:Strings.SetupGmChoice}">
                            <RadioButton GroupName="SetupGameMode" IsChecked="{x:Bind ViewModel.GameModeOff, Mode=TwoWay}"
                                         Content="{x:Bind s:Strings.SetupGmOff}" AutomationProperties.Name="{x:Bind s:Strings.SetupGmOff}" />
                            <RadioButton GroupName="SetupGameMode" IsChecked="{x:Bind ViewModel.GameModeNoAdmin, Mode=TwoWay}"
                                         Content="{x:Bind s:Strings.SetupGmNoAdmin}" AutomationProperties.Name="{x:Bind s:Strings.SetupGmNoAdmin}" />
                            <RadioButton GroupName="SetupGameMode" IsChecked="{x:Bind ViewModel.GameModeAll, Mode=TwoWay}"
                                         Visibility="{x:Bind ViewModel.ShowAllOption, Mode=OneWay}"
                                         AutomationProperties.Name="{x:Bind s:Strings.SetupGmAll}"
                                         AutomationProperties.HelpText="{x:Bind ViewModel.AllText, Mode=OneWay}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind s:Strings.SetupGmAll}" />
                                        <FontIcon Glyph="&#xEA18;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.AllText, Mode=OneWay}" />
                                </StackPanel>
                            </RadioButton>
                            <TextBlock Style="{StaticResource RowDetail}" Margin="0,6,0,2" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.ShowNeedsAdmin, Mode=OneWay}" Text="{x:Bind s:Strings.GmHelperNeedsAdmin}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0" Padding="16,14">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind s:Strings.SetupGmChangesTitle}" />
                            <StackPanel x:Name="GameModeList" Spacing="6" AutomationProperties.Name="{x:Bind s:Strings.SetupGmChangesTitle}" />
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <Border x:Name="HelperCard" Style="{StaticResource SettingCard}" Margin="0,0,0,6">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xEA18;" />
                                <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" VerticalAlignment="Center"
                                           Text="{x:Bind s:Strings.SetupGmHelperTitle}" />
                                <Button x:Name="HelperChevron" Grid.Column="2" Style="{StaticResource DisclosureButton}" />
                            </Grid>
                        </Border>
                        <Border x:Name="HelperBody" Style="{StaticResource SettingCardBody}" Margin="0">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind s:Strings.SetupGmHelperText}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind s:Strings.SetupGmChangeLater}" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2">
                <Button HorizontalAlignment="Left" Content="{x:Bind s:Strings.Back}" Command="{x:Bind ViewModel.BackToStep3Command}" />
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Padding="22,6"
                        Command="{x:Bind ViewModel.DoneCommand}" IsEnabled="{x:Bind ViewModel.DoneEnabled, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.DoneText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEA18;" FontSize="14" Visibility="{x:Bind ViewModel.DoneNeedsAdmin, Mode=OneWay}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="{x:Bind ViewModel.DoneText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Step 2's moved shortcuts fly into Binder's logo here (LogoMerge); empty otherwise. -->
        <Canvas x:Name="MergeLayer" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</UserControl>
