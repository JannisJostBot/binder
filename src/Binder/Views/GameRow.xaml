<UserControl x:Class="Binder.Views.GameRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Binder.Views"
             IsTabStop="False">
    <!-- List view (board 11): small cover, name, launcher, last played. Clicking the row plays, like a cover;
         the Details (i) button appears on hover. -->
    <Grid Height="52" ColumnSpacing="12" Background="Transparent" PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited" PointerCanceled="OnPointerExited" PointerCaptureLost="OnPointerExited">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <v:CoverView x:Name="Cover" Width="30" Height="40" DecodeWidth="30" CornerRadius="4" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="NameText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <FontIcon x:Name="FavoriteIcon" Glyph="&#xE735;" FontSize="11" Foreground="{ThemeResource FavoriteBrush}"
                      Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="SourceText" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="LastPlayedText" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Right"
                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <!-- Always in the tree for screen readers and UI Automation; seen and clickable on hover. -->
        <Button x:Name="DetailsButton" Grid.Column="4" Style="{StaticResource IconButton}" Width="32" Height="32"
                FontSize="14" Content="&#xE946;" IsTabStop="False" Opacity="0" IsHitTestVisible="False"
                Click="OnDetailsClick" />
    </Grid>
</UserControl>
