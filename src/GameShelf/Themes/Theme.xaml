<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The panel uses WinUI's own controls and Windows' theme resources (TextFillColorPrimaryBrush,
        CardBackgroundFillColorDefaultBrush, AccentFillColorDefaultBrush, ...), so it follows the system light/dark
        mode, accent color, high contrast and text size by itself, live. Only what Windows has no token for is
        defined here.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="FavoriteBrush" Color="#F3C64C" />
            <!-- The Game mode toast (board 23): a solid surface, not Acrylic, so its round ends and shadow stay crisp. -->
            <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#2C2C30" />
            <SolidColorBrush x:Key="ToastStrokeBrush" Color="#3E3E45" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FavoriteBrush" Color="#C98A00" />
            <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="ToastStrokeBrush" Color="#DADADA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FavoriteBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToastSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ToastStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Drawn over cover art, so the same in light and dark mode. -->
    <!-- Chips on cover art (launcher badge, favorite star, Details): near-solid dark with a thin light edge, so
         they stand out on dark and light art alike, the way Fluent separates layered surfaces. Same in both themes:
         they sit on the art, not on the panel. -->
    <SolidColorBrush x:Key="BadgeBrush" Color="#E01C1C20" />
    <SolidColorBrush x:Key="BadgeHoverBrush" Color="#F032323A" />
    <SolidColorBrush x:Key="BadgeStrokeBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="CoverOverlayBrush" Color="#40000000" />
    <!-- The "Continue playing" banner: a fade at the bottom of the hero art so its light text reads on any image. -->
    <LinearGradientBrush x:Key="BannerScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.25" Color="#00000000" />
        <GradientStop Offset="1" Color="#D9000000" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BannerSecondaryTextBrush" Color="#D6D6DC" />

    <!-- Section heading above a group of settings rows, as in Windows Settings. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="20,24,20,8" />
    </Style>

    <!-- A group of settings rows, like a Windows Settings card. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Margin" Value="20,0" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Controller hints (board 3): LB / RB beside the filters, round button keys in the hint bar. -->
    <Style x:Key="PadPill" TargetType="Border">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="PadPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="PadKey" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="PadKeyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RowDetail" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="-16,0" />
        <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- A settings row: text on the left, a control on the right. -->
    <Style x:Key="SettingRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="RowText" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <!--
        Settings and Game detail (board 19 and 21): one Windows Settings-style card per setting, a little apart,
        with an icon, under a group heading. A card that opens (Disclosure) shows its body joined underneath.
    -->
    <Style x:Key="GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="20,36,20,12" />
    </Style>

    <Style x:Key="SettingCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Margin" Value="20,0,20,6" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="52" />
    </Style>

    <!-- The opened part of a card: joined to it, a shade darker, indented to line up with the card's title. -->
    <Style x:Key="SettingCardBody" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="CornerRadius" Value="0,0,8,8" />
        <Setter Property="Margin" Value="20,0,20,6" />
        <Setter Property="Padding" Value="52,12,16,16" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- A card that is a link to another page (Game mode, Free up space): the whole card is the button. -->
    <Style x:Key="SettingLinkCard" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Margin" Value="20,0,20,6" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="CardIcon" TargetType="FontIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Width" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The chevron that opens a card. -->
    <Style x:Key="DisclosureButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Content" Value="&#xE70D;" />
        <Setter Property="Margin" Value="0,0,-8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ToggleSwitch without its On/Off label, as in Windows Settings rows where the row names it. -->
    <Style x:Key="RowSwitch" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,-12,0" />
    </Style>

    <!-- Square icon-only button (settings, pin, back). -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="IconToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- The round Details (i) button on a hovered cover. The cover itself plays. -->
    <Style x:Key="CoverDetailsButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{StaticResource BadgeBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BadgeStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Content" Value="&#xE946;" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
</ResourceDictionary>
