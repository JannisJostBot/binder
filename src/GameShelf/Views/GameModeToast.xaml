<Window x:Class="GameShelf.Views.GameModeToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Shelf">
    <!-- Game mode's toast (board 23): a compact one-line pill, "Game mode on · 5 changes" after it applied and
         "Back to normal · 5 changes put back" after the restore; something that couldn't be changed or put back
         gets a larger card with room for the names and a way to the log. Centered above the taskbar like the
         volume flyout; the window is sized to this content once it has been laid out. The storyboard runs once
         when it shows (not at all when animations are off). -->
    <!-- The window itself is transparent (TransparentBackdrop); Roots padding leaves room for the shadow. -->
    <Grid x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="28,20,28,32">
        <Grid.Resources>
            <Storyboard x:Name="ShowStoryboard">
                <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" From="0.4" To="1" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" From="0.4" To="1" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="StrokeDashOffset" From="8" To="0"
                                 BeginTime="0:0:0.15" Duration="0:0:0.35" EnableDependentAnimation="True">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                <DoubleAnimation Storyboard.TargetName="BodyShift" Storyboard.TargetProperty="Y" From="6" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <Grid x:Name="Body">
            <Grid.RenderTransform><TranslateTransform x:Name="BodyShift" /></Grid.RenderTransform>
            <!-- The soft shadow under the surface (a composition drop shadow, drawn once; none in high contrast). -->
            <Border x:Name="ShadowHost" IsHitTestVisible="False" />
            <!-- The surface: fully round ends on the 48 px pill, the same radius on the card. -->
            <Border x:Name="Surface" CornerRadius="24" BorderThickness="1" Background="{ThemeResource ToastSurfaceBrush}"
                    BorderBrush="{ThemeResource ToastStrokeBrush}">
            <Grid>

            <!-- The pill: a small round dot (accent while game mode is on, neutral with a green check once Windows
                 is back to normal) and one line of text. -->
            <Grid x:Name="Pill" Height="46" Padding="9,0,19,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="Dot" Width="28" Height="28" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                      AutomationProperties.AccessibilityView="Raw">
                    <Grid.RenderTransform><ScaleTransform x:Name="DotScale" /></Grid.RenderTransform>
                    <Ellipse x:Name="DotFill" Fill="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" />
                    <!-- On: a gauge. Back to normal: a check that draws itself. -->
                    <FontIcon x:Name="OnGlyph" Glyph="&#xEC4A;" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <Path x:Name="Mark" Data="M 9,14.5 L 12.5,18 L 19.5,10.5" StrokeThickness="2" StrokeDashArray="8 8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="LineText" Grid.Column="1" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Assertive">
                    <Run x:Name="LineTitle" FontWeight="SemiBold" /><Run x:Name="LineDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
            </Grid>

            <!-- Something couldn't be changed or put back: a card with the whole message and the way to the log. -->
            <Grid x:Name="Card" Width="378" Padding="12,12,10,16" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Width="28" Height="28" Margin="0,2,0,0" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                    <Ellipse Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="!" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,0,0,2" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="4" Padding="0,5,0,0">
                    <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                        Width="32" Height="32" VerticalAlignment="Top" Click="OnCloseClick"
                        ToolTipService.ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
                <Button x:Name="DetailsButton" Grid.Row="1" Grid.Column="1" Content="Open the Game mode log" Click="OnDetailsClick"
                        Visibility="Collapsed" />
            </Grid>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
