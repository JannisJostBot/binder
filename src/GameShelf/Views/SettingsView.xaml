<UserControl x:Class="GameShelf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:GameShelf.Views"
             AutomationProperties.Name="Settings">
    <UserControl.Resources>
        <Style x:Key="SourceCheck" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!--
        Board 19: one card per setting, grouped as in Windows Settings. A second line shows only when it says
        something about the state (12 imported, 72 games, a shortcut that's taken); explanations are tooltips, and
        rarely used parts open from their card (Disclosure).
    -->
    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="0,20,0,24">
            <!-- Header -->
            <Grid Margin="16,0,20,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{x:Bind ViewModel.BackCommand}"
                        ToolTipService.ToolTip="Back to all games (Esc)" AutomationProperties.Name="Back to all games" />
                <TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            </Grid>

            <!-- Opening Game Shelf (board 9) -->
            <TextBlock Style="{StaticResource GroupLabel}" Margin="20,20,20,12" Text="Opening Game Shelf" />
            <Border x:Name="ModeCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7C4;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Show it as" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.ModeText, Mode=OneWay}" />
                    </StackPanel>
                    <Button x:Name="ModeChevron" Grid.Column="2" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="ModeBody" Style="{StaticResource SettingCardBody}">
                <RadioButtons MaxColumns="2" AutomationProperties.Name="Show it as"
                              SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                    <RadioButton Tag="Flyout" ToolTipService.ToolTip="Slides in from the notification-area icon and hides when you click away">
                        <StackPanel Width="170">
                            <v:ModePreview HorizontalAlignment="Left" Width="150" Height="82" Margin="0,2,0,8" />
                            <TextBlock Text="Flyout" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Tag="Desktop" ToolTipService.ToolTip="Always there, behind your windows">
                        <StackPanel Width="170">
                            <v:ModePreview HorizontalAlignment="Left" Width="150" IsDesktop="True" Height="82" Margin="0,2,0,8" />
                            <TextBlock Text="On the desktop" />
                        </StackPanel>
                    </RadioButton>
                </RadioButtons>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE765;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Keyboard shortcut" />
                        <TextBlock Style="{StaticResource RowDetail}" Visibility="{x:Bind ViewModel.HotkeyTaken, Mode=OneWay}" Text="Taken by another app: choose a different one"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" Style="{StaticResource RowCombo}" AutomationProperties.Name="Keyboard shortcut"
                              ItemsSource="{x:Bind ViewModel.HotkeyLabels}" SelectedIndex="{x:Bind ViewModel.HotkeyIndex, Mode=TwoWay}"
                              ToolTipService.ToolTip="{x:Bind ViewModel.HotkeyToolTip, Mode=OneWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="Click it to open or close Game Shelf, like the volume and network icons">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xEA8F;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Icon in the notification area" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.TrayIcon, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="Icon in the notification area" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="Pin the flyout open from its header when you want it to stay">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7C9;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Hide when I click elsewhere" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CloseOnClickAway, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="Hide when I click elsewhere" />
                </Grid>
            </Border>

            <Border x:Name="StayReadyCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="Keeps running in efficiency mode after you close it, so it opens quickly">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE945;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Stay ready in the background" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.StayReadyText, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.StayReady, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="Stay ready in the background" />
                    <Button x:Name="StayReadyChevron" Grid.Column="3" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="StayReadyBody" Style="{StaticResource SettingCardBody}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowTitle}" Text="While it's closed" />
                        <ComboBox Grid.Column="1" Style="{StaticResource RowCombo}" AutomationProperties.Name="While it's closed"
                                  SelectedIndex="{x:Bind ViewModel.KeepLoadedIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.KeepLoadedEnabled, Mode=OneWay}">
                            <ComboBoxItem Content="Open faster" Tag="Fast" />
                            <ComboBoxItem Content="Use less memory" Tag="Light" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.KeepLoadedDetail, Mode=OneWay}" Style="{StaticResource RowDetail}" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7E8;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Start with Windows" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="Start with Windows" />
                </Grid>
            </Border>

            <!-- When a game starts -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="When a game starts" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE916;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Hide Game Shelf" />
                    <ComboBox Grid.Column="2" Style="{StaticResource RowCombo}"
                              AutomationProperties.Name="Hide delay" SelectedIndex="{x:Bind ViewModel.DelayIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Instantly" Tag="0" />
                        <ComboBoxItem Content="After 5 s" Tag="5" />
                        <ComboBoxItem Content="After 10 s" Tag="10" />
                        <ComboBoxItem Content="After 30 s" Tag="30" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="Reopens Game Shelf automatically">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7A7;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Come back when the game closes" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ComeBackOnClose, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="Come back when the game closes" />
                </Grid>
            </Border>
            <!-- Game mode (spec §11): its own page -->
            <Button Style="{StaticResource SettingLinkCard}" Command="{x:Bind ViewModel.GameModeCommand}" AutomationProperties.Name="Game mode settings">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7FC;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Game mode" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.GameModeText, Mode=OneWay}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>

            <!-- Shelf (board 9) -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="Shelf" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xECA5;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Cover size" />
                    <ComboBox Grid.Column="2" Style="{StaticResource RowCombo}"
                              AutomationProperties.Name="Cover size" SelectedIndex="{x:Bind ViewModel.DensityIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Small" Tag="Small" />
                        <ComboBoxItem Content="Medium" Tag="Medium" />
                        <ComboBoxItem Content="Large" Tag="Large" />
                        <ComboBoxItem Content="List" Tag="List" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="A card above the games with time played per day">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE9D2;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Show this week's playtime" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShowWeeklySummary, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="Show this week's playtime" />
                </Grid>
            </Border>

            <!-- Library -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="Library" />
            <Border x:Name="SourcesCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE8F1;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Game sources" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.LibraryText, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" VerticalAlignment="Center"
                            AutomationProperties.Name="Refresh library" ToolTipService.ToolTip="Look for new games" />
                    <Button x:Name="SourcesChevron" Grid.Column="3" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="SourcesBody" Style="{StaticResource SettingCardBody}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <CheckBox IsChecked="{x:Bind ViewModel.SteamEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Steam" />
                        <CheckBox IsChecked="{x:Bind ViewModel.EpicEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Epic Games" />
                        <CheckBox IsChecked="{x:Bind ViewModel.GogEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="GOG" />
                        <CheckBox IsChecked="{x:Bind ViewModel.EaEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="EA app" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <CheckBox IsChecked="{x:Bind ViewModel.UbisoftEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Ubisoft Connect" />
                        <CheckBox IsChecked="{x:Bind ViewModel.XboxEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Xbox app (Game Pass)" />
                        <CheckBox IsChecked="{x:Bind ViewModel.RockstarEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Rockstar Games"
                                  AutomationProperties.Name="Rockstar Games Launcher" />
                        <CheckBox IsChecked="{x:Bind ViewModel.HytaleEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Hytale"
                                  AutomationProperties.Name="Hytale Launcher" />
                        <CheckBox IsChecked="{x:Bind ViewModel.ShortcutsEnabled, Mode=TwoWay}" Style="{StaticResource SourceCheck}" Content="Desktop shortcuts"
                                  AutomationProperties.Name="Imported desktop shortcuts" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ShortcutsCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE71B;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Desktop shortcuts" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.ShortcutsText, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Import…" Command="{x:Bind ViewModel.ImportCommand}" VerticalAlignment="Center"
                            AutomationProperties.Name="Import desktop shortcuts"
                            ToolTipService.ToolTip="Move game shortcuts off your desktop into the shelf" />
                    <Button x:Name="ShortcutsChevron" Grid.Column="3" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="ShortcutsBody" Style="{StaticResource SettingCardBody}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                               Text="Puts the imported shortcuts back on your desktop and takes them off the shelf." />
                    <Button Grid.Column="1" Content="Restore" Command="{x:Bind ViewModel.RestoreCommand}" IsEnabled="{x:Bind ViewModel.CanRestoreShortcuts, Mode=OneWay}" VerticalAlignment="Center"
                            AutomationProperties.Name="Restore shortcuts to desktop" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE710;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Add a game" />
                    <Button Grid.Column="2" Content="Browse…" Command="{x:Bind ViewModel.AddGameCommand}" VerticalAlignment="Center"
                            AutomationProperties.Name="Add a game" ToolTipService.ToolTip="A program (.exe) or a shortcut" />
                </Grid>
            </Border>

            <Border x:Name="HiddenCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xED1A;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Hidden games" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.HiddenCountText, Mode=OneWay}" />
                    </StackPanel>
                    <Button x:Name="HiddenChevron" Grid.Column="2" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="HiddenBody" Style="{StaticResource SettingCardBody}" Padding="52,0,16,0">
                <StackPanel>
                    <StackPanel x:Name="HiddenList" AutomationProperties.Name="Hidden games" />
                    <TextBlock Visibility="{x:Bind ViewModel.NoHiddenGames, Mode=OneWay}" Margin="0,14" TextWrapping="Wrap" Style="{StaticResource RowDetail}" TextTrimming="None"
                               Text="No hidden games. Hide one from its right-click menu or its details." />
                </StackPanel>
            </Border>

            <!-- Storage (spec §12) -->
            <Button Style="{StaticResource SettingLinkCard}" Command="{x:Bind ViewModel.FreeSpaceCommand}" AutomationProperties.Name="Free up space"
                    ToolTipService.ToolTip="See which games to remove to make room for a new one">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xEDA2;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Free up space" />
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>

            <!-- Window -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="Window" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE8A9;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Position" />
                        <TextBlock Style="{StaticResource RowDetail}" Visibility="{x:Bind ViewModel.PositionIsFree, Mode=OneWay}"
                                   Text="Drag it by an empty spot to move it" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" Style="{StaticResource RowCombo}"
                              AutomationProperties.Name="Position" SelectedIndex="{x:Bind ViewModel.PositionIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Left edge" Tag="Left" />
                        <ComboBoxItem Content="Right edge" Tag="Right" />
                        <ComboBoxItem Content="Free" Tag="Free" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}" Visibility="{x:Bind ViewModel.ShowScreens, Mode=OneWay}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="Numbered from left to right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7F4;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Screen" />
                    <ComboBox Grid.Column="2" Style="{StaticResource RowCombo}" AutomationProperties.Name="Screen"
                              ItemsSource="{x:Bind ViewModel.Screens, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.ScreenIndex, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="Sits behind other windows, like desktop icons">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE81E;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Stay on the desktop layer" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.StayOnDesktop, Mode=TwoWay}" Grid.Column="2" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="Stay on the desktop layer" />
                </Grid>
            </Border>
            <HyperlinkButton Margin="8,24,20,0" Content="Run first-time setup again" Command="{x:Bind ViewModel.SetupCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
