<UserControl x:Class="GameShelf.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:GameShelf">
    <!-- Game mode settings (spec §11, board 5): the part that needs no admin rights. -->
    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="0,20,0,24">
            <!-- Header -->
            <Grid Margin="16,0,20,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{x:Bind ViewModel.BackCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.BackToolTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.BackName, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind s:Strings.GameMode}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            </Grid>

            <!-- Master switch -->
            <Border Style="{StaticResource Card}" Margin="20,16,20,0">
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind s:Strings.GmMaster}" />
                        <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap"
                                   Text="{x:Bind s:Strings.GmMasterText}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MasterSwitch" Grid.Column="1" Style="{StaticResource RowSwitch}"
                                  AutomationProperties.Name="{x:Bind s:Strings.GmMaster}" IsOn="{x:Bind ViewModel.MasterOn, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- The admin part: one "Allow…" (a UAC prompt) installs the helper. -->
            <InfoBar x:Name="AllowBar" Margin="20,10,20,0" IsClosable="False" Severity="Informational"
                     IsOpen="{x:Bind ViewModel.AllowBarOpen, Mode=OneWay}" Message="{x:Bind ViewModel.AllowMessage, Mode=OneWay}"
                     Title="{x:Bind s:Strings.GmAllowTitle}">
                <InfoBar.ActionButton>
                    <Button x:Name="AllowButton" Content="{x:Bind ViewModel.AllowText, Mode=OneWay}" Click="OnAllowClick"
                            Visibility="{x:Bind ViewModel.ShowAllow, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.AllowEnabled, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind s:Strings.GmAllowName}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Performance -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Bind s:Strings.GmPerformance}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmPowerTitle}" />
                            <TextBlock x:Name="PowerText" Style="{StaticResource RowDetail}" TextWrapping="Wrap" Text="{x:Bind ViewModel.PowerText, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="PowerSwitch" Grid.Column="1" Style="{StaticResource RowSwitch}" AutomationProperties.Name="{x:Bind s:Strings.GmPowerTitle}" IsOn="{x:Bind ViewModel.PowerOn, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmPriorityTitle}" />
                            <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap"
                                       Text="{x:Bind s:Strings.GmPriorityText}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="PrioritySwitch" Grid.Column="1" Style="{StaticResource RowSwitch}" AutomationProperties.Name="{x:Bind s:Strings.GmPriorityTitle}" IsOn="{x:Bind ViewModel.PriorityOn, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Pause background services (admin part) and Game Bar recording (no admin rights needed) -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Bind s:Strings.GmServicesTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel x:Name="ServiceList" />
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmGameBarTitle}" />
                            <TextBlock x:Name="GameBarText" Style="{StaticResource RowDetail}" TextWrapping="Wrap" Text="{x:Bind ViewModel.GameBarText, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="GameBarSwitch" Grid.Column="1" Style="{StaticResource RowSwitch}" AutomationProperties.Name="{x:Bind s:Strings.GmGameBarName}" IsOn="{x:Bind ViewModel.GameBarOn, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmOneDriveTitle}" />
                            <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap" Text="{x:Bind ViewModel.OneDriveText, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource RowSwitch}"
                                      AutomationProperties.Name="{x:Bind s:Strings.GmOneDriveTitle}" IsOn="{x:Bind ViewModel.OneDriveOn, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network (admin part) -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Bind s:Strings.GmNetwork}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmSmoothTitle}" />
                            <TextBlock x:Name="SmoothText" Style="{StaticResource RowDetail}" TextWrapping="Wrap" Text="{x:Bind ViewModel.SmoothText, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SmoothSwitch" Grid.Column="1" Style="{StaticResource RowSwitch}" AutomationProperties.Name="{x:Bind s:Strings.GmSmoothTitle}" IsOn="{x:Bind ViewModel.SmoothOn, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.HelperAllowed, Mode=OneWay}" />
                    </Grid>
                    <StackPanel x:Name="SmoothList" AutomationProperties.Name="{x:Bind s:Strings.GmSmoothList}" />
                    <Button x:Name="AddSmoothButton" Click="OnAddSmoothClick" IsEnabled="{x:Bind ViewModel.HelperAllowed, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,4,0,12"
                            AutomationProperties.Name="{x:Bind s:Strings.GmAddSmooth}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{x:Bind s:Strings.GmAddRunningApp}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmUploadsTitle}" />
                            <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap"
                                       Text="{x:Bind s:Strings.GmUploadsText}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="UploadsSwitch" Grid.Column="1" Style="{StaticResource RowSwitch}" AutomationProperties.Name="{x:Bind s:Strings.GmUploadsTitle}" IsOn="{x:Bind ViewModel.UploadsOn, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.HelperAllowed, Mode=OneWay}" />
                    </Grid>
                    <Grid Margin="0,0,0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind s:Strings.GmUploadLimit}" Style="{StaticResource RowDetail}" VerticalAlignment="Center" />
                        <ComboBox x:Name="LimitBox" Grid.Column="1" MinWidth="120" IsEnabled="{x:Bind ViewModel.HelperAllowed, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.LimitIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind s:Strings.GmUploadLimit}">
                            <ComboBoxItem Content="1 Mbit/s" Tag="1" />
                            <ComboBoxItem Content="5 Mbit/s" Tag="5" />
                            <ComboBoxItem Content="20 Mbit/s" Tag="20" />
                        </ComboBox>
                    </Grid>
                    <StackPanel x:Name="UploadList" AutomationProperties.Name="{x:Bind s:Strings.GmUploadList}" />
                    <Button x:Name="AddUploadButton" Click="OnAddUploadClick" IsEnabled="{x:Bind ViewModel.HelperAllowed, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,4,0,12"
                            AutomationProperties.Name="{x:Bind s:Strings.GmAddUpload}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{x:Bind s:Strings.GmAddRunningApp}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmUpdatesTitle}" />
                            <TextBlock x:Name="UpdatesText" Style="{StaticResource RowDetail}" TextWrapping="Wrap" Text="{x:Bind ViewModel.UpdatesText}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="UpdatesSwitch" Grid.Column="1" Style="{StaticResource RowSwitch}" AutomationProperties.Name="{x:Bind s:Strings.GmUpdatesTitle}" IsOn="{x:Bind ViewModel.UpdatesOn, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.HelperAllowed, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap" Margin="20,10,20,0"
                       Text="{x:Bind s:Strings.GmDownloadsNote}" />

            <!-- Close apps while playing -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Bind s:Strings.GmAppsTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Padding="0,4,0,12">
                    <StackPanel x:Name="AppList" AutomationProperties.Name="{x:Bind s:Strings.GmAppList}" />
                    <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap" Margin="0,10,0,10"
                               Text="{x:Bind s:Strings.GmAppsText}" />
                    <Button x:Name="AddAppButton" Click="OnAddAppClick" HorizontalAlignment="Left"
                            AutomationProperties.Name="{x:Bind s:Strings.GmAddRunningApp}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{x:Bind s:Strings.GmAddRunningApp}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Windows' own gaming settings: read when the page opens, changed only in Windows Settings -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Bind s:Strings.GmWindowsSettings}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmWinGameMode}" />
                            <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap" Text="{x:Bind ViewModel.WinGameModeText, Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.OpenGameModeSettingsCommand}"
                                AutomationProperties.Name="{x:Bind s:Strings.GmOpenWinGameMode}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.WinGameModeState, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" Visibility="{x:Bind ViewModel.WindowedVisible, Mode=OneWay}" />
                    <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12" Visibility="{x:Bind ViewModel.WindowedVisible, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmWindowedTitle}" />
                            <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap" Text="{x:Bind ViewModel.WindowedText, Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.OpenGraphicsSettingsCommand}"
                                AutomationProperties.Name="{x:Bind s:Strings.GmOpenWindowed}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.WindowedState, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmDnd}" />
                            <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap"
                                       Text="{x:Bind s:Strings.GmDndText}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.OpenNotificationSettingsCommand}"
                                AutomationProperties.Name="{x:Bind s:Strings.GmOpenNotifications}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind s:Strings.Open}" />
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- When the game closes -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Bind s:Strings.GmWhenCloses}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmToastTitle}" />
                            <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap"
                                       Text="{x:Bind s:Strings.GmToastText}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ToastSwitch" Grid.Column="1" Style="{StaticResource RowSwitch}"
                                      AutomationProperties.Name="{x:Bind s:Strings.GmToastName}" IsOn="{x:Bind ViewModel.ToastOn, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind s:Strings.GmSoundTitle}" />
                            <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap"
                                       Text="{x:Bind s:Strings.GmSoundText}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SoundSwitch" Grid.Column="1" Style="{StaticResource RowSwitch}"
                                      AutomationProperties.Name="{x:Bind s:Strings.GmSoundName}" IsOn="{x:Bind ViewModel.SoundOn, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="LastIcon" Glyph="&#xE930;" FontSize="18" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                            <TextBlock x:Name="LastTitle" Style="{StaticResource RowTitle}" Text="{x:Bind ViewModel.LastTitle, Mode=OneWay}" />
                            <TextBlock x:Name="LastDetail" Style="{StaticResource RowDetail}" TextWrapping="Wrap" Text="{x:Bind ViewModel.LastDetail, Mode=OneWay}" />
                        </StackPanel>
                        <Button x:Name="LogButton" Grid.Column="2" Content="{x:Bind s:Strings.ViewLog}" Command="{x:Bind ViewModel.LogCommand}" IsEnabled="{x:Bind ViewModel.HasLog, Mode=OneWay}" VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind s:Strings.GmViewLogName}" />
                    </Grid>
                </StackPanel>
            </Border>
            <Button x:Name="RestoreButton" Margin="20,10,20,0" Command="{x:Bind ViewModel.RestoreCommand}" HorizontalAlignment="Left"
                    Content="{x:Bind ViewModel.RestoreText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanRestore, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind s:Strings.RestoreNow}" />

            <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap" Margin="20,16,20,0"
                       Text="{x:Bind s:Strings.GmPerGameNote}" />
            <StackPanel x:Name="RemovePanel" Orientation="Horizontal" Spacing="4" Margin="20,8,20,0" Visibility="{x:Bind ViewModel.HelperAllowed, Mode=OneWay}">
                <TextBlock Style="{StaticResource RowDetail}" VerticalAlignment="Center"
                           Text="{x:Bind s:Strings.GmHelperNote}" />
                <HyperlinkButton x:Name="RemoveButton" Content="{x:Bind s:Strings.RemoveIt}" Click="OnRemoveClick" Padding="4,2" IsEnabled="{x:Bind ViewModel.RemoveEnabled, Mode=OneWay}"
                                 AutomationProperties.Name="{x:Bind s:Strings.GmRemoveName}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
