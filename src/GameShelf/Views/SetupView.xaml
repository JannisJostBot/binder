<UserControl x:Class="GameShelf.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:GameShelf.Views"
             AutomationProperties.Name="First-time setup">
    <UserControl.Resources>
        <Style x:Key="StepLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="28">
        <!-- Step 1: launchers found -->
        <Grid x:Name="Step1" RowSpacing="18" Visibility="{x:Bind ViewModel.IsStep1, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource StepLabel}" Text="Step 1 of 3" />
                <TextBlock Style="{StaticResource StepTitle}" Text="{x:Bind ViewModel.FoundTitle, Mode=OneWay}" />
                <TextBlock Style="{StaticResource StepText}"
                           Text="Untick any launcher you don't want on the shelf. You can change this later in Settings." />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel x:Name="LauncherList" Margin="0,6" AutomationProperties.Name="Launchers" />
                    <TextBlock Margin="0,14" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.NothingFound, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="No store games found yet. You can import desktop shortcuts next, or add games later." />
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Button HorizontalAlignment="Left" Content="Skip setup" Command="{x:Bind ViewModel.SkipCommand}" />
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Padding="22,6" Content="Next"
                        Command="{x:Bind ViewModel.NextCommand}" AutomationProperties.Name="Next" />
            </Grid>
        </Grid>

        <!-- Step 2: tidy the desktop -->
        <Grid x:Name="Step2" RowSpacing="14" Visibility="{x:Bind ViewModel.IsStep2, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource StepLabel}" Text="Step 2 of 3" />
                <TextBlock Style="{StaticResource StepTitle}" Text="Tidy up your desktop?" />
                <TextBlock Style="{StaticResource StepText}"
                           Text="Tick the game shortcuts to move onto the shelf. They're kept in a safe folder, never deleted, and you can put them back anytime." />
            </StackPanel>
            <v:ImportView x:Name="Picker" Grid.Row="1" />
            <TextBlock Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid Grid.Row="3">
                <Button HorizontalAlignment="Left" Content="Back" Command="{x:Bind ViewModel.BackToStep1Command}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Not now" Command="{x:Bind ViewModel.NotNowCommand}" />
                    <Button Style="{StaticResource AccentButtonStyle}" Padding="22,6" Command="{x:Bind ViewModel.MoveCommand}"
                            Content="{x:Bind ViewModel.MoveText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanMove, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Step 3: how it opens -->
        <Grid x:Name="Step3" RowSpacing="18" Visibility="{x:Bind ViewModel.IsStep3, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource StepLabel}" Text="Step 3 of 3" />
                <TextBlock Style="{StaticResource StepTitle}" Text="How should it open?" />
            </StackPanel>
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton GroupName="SetupMode" AutomationProperties.Name="Flyout" IsChecked="{x:Bind ViewModel.Flyout, Mode=TwoWay}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <StackPanel>
                                <v:ModePreview Height="100" Margin="0,0,0,10" />
                                <TextBlock Text="Flyout" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Slides in from the tray icon or shortcut, hides when you click away." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" GroupName="SetupMode" AutomationProperties.Name="On the desktop" IsChecked="{x:Bind ViewModel.Desktop, Mode=TwoWay}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <StackPanel>
                                <v:ModePreview IsDesktop="True" Height="100" Margin="0,0,0,10" />
                                <TextBlock Text="On the desktop" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Always visible on the desktop, behind your windows." />
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Start with Windows" />
                                <ToggleSwitch Style="{StaticResource RowSwitch}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                              AutomationProperties.Name="Start with Windows" />
                            </Grid>
                            <Border Style="{StaticResource RowDivider}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Open anytime with" />
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind ViewModel.HotkeyText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Where to find it"
                             Message="Game Shelf lives next to the clock. Windows may tuck new icons behind the ^ arrow, so drag it onto the taskbar to keep it one click away. Pinning it to the taskbar also works." />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2">
                <Button HorizontalAlignment="Left" Content="Back" Command="{x:Bind ViewModel.BackToStep2Command}" />
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Padding="22,6" Content="Done"
                        Command="{x:Bind ViewModel.DoneCommand}" AutomationProperties.Name="Done" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
