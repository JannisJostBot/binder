<UserControl x:Class="GameShelf.Views.GameTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:GameShelf.Views"
             IsTabStop="False">
    <!-- Hover anywhere on the tile (cover, gap or title): a click on any of it plays. Transparent background so
         the gap between cover and title is hit-testable too. -->
    <StackPanel x:Name="Hit" Spacing="8" Background="Transparent" PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"
                PointerCanceled="OnPointerExited" PointerCaptureLost="OnPointerExited">
        <!-- Clicking the cover plays (the grid's ItemClick); the (i) button opens details (board 15, option A). -->
        <!-- Hover (board 26, option C "Media tile"): the cover lifts to 1.04 with a shadow, a fine light edge and a
             fade on its bottom half, and a round Play button rises into the corner beside Details. The scale,
             lift and fades are UIElement transitions set in code (none with "Animation effects" off). -->
        <Grid x:Name="CoverArea" SizeChanged="OnCoverSizeChanged">
            <v:CoverView x:Name="Cover" />
            <!-- Shown until (or unless) a cover image loads. -->
            <TextBlock x:Name="PlaceholderTitle" Margin="10" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="Scrim" CornerRadius="8" Background="{ThemeResource CoverScrimBrush}" IsHitTestVisible="False" Opacity="0" />
            <Border x:Name="Edge" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CoverHoverEdgeBrush}"
                    IsHitTestVisible="False" Opacity="0" />
            <!-- High contrast only (its brush is transparent otherwise): a highlight outline instead of the shadow,
                 fade and edge. -->
            <Border x:Name="HighContrastOutline" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource CoverHighContrastOutlineBrush}"
                    IsHitTestVisible="False" Opacity="0" />
            <v:LauncherBadge x:Name="Badge" />
            <!-- Star on favorite covers, top-right (board 7). -->
            <Border x:Name="FavoriteBadge" Width="26" Height="26" Margin="6" CornerRadius="13"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                    Background="{StaticResource BadgeBrush}" BorderBrush="{StaticResource BadgeStrokeBrush}" BorderThickness="1"
                    ToolTipService.ToolTip="Favorite">
                <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="{ThemeResource FavoriteBrush}" />
            </Border>
            <!-- What a click does: Play, bottom left. Not hit-testable, the click goes to the cover (the grid plays). -->
            <Border x:Name="PlayMark" Width="36" Height="36" Margin="6" CornerRadius="18" HorizontalAlignment="Left"
                    VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}"
                    IsHitTestVisible="False" Opacity="0">
                <FontIcon Glyph="&#xF5B0;" FontSize="14" Margin="2,0,0,0" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <!-- Controller focus (board 3): a bold ring just outside the cover, instead of the thin system one. -->
            <Border x:Name="PadRing" Margin="-4" CornerRadius="12" BorderThickness="3" IsHitTestVisible="False"
                    BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
            <!-- Always in the tree so screen readers and UI Automation can reach it; seen and clickable on hover. -->
            <Button x:Name="DetailsButton" Style="{StaticResource CoverDetailsButton}" Margin="6"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"
                    ToolTipService.ToolTip="Details" Click="OnDetailsClick">
                <!-- Its own hover and press look: WinUI's default button fills would turn it grey on the art. -->
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="BadgeHoverBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="BadgeBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BadgeStrokeBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BadgeStrokeBrush" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#D0FFFFFF" />
                </Button.Resources>
            </Button>
        </Grid>
        <!-- The full name as a tooltip only when it's cut off with "…", like File Explorer. -->
        <TextBlock x:Name="TitleText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" IsTextTrimmedChanged="OnTitleTrimmedChanged"
                   TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
