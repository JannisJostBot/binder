<UserControl x:Class="GameShelf.Views.GameTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:GameShelf.Views"
             IsTabStop="False">
    <StackPanel Spacing="8">
        <Grid x:Name="CoverArea" PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"
              PointerCanceled="OnPointerExited" PointerCaptureLost="OnPointerExited">
            <v:CoverView x:Name="Cover" />
            <!-- Shown until (or unless) a cover image loads. -->
            <TextBlock x:Name="PlaceholderTitle" Margin="10" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <v:LauncherBadge x:Name="Badge" />
            <!-- Star on favorite covers, top-right (board 7). -->
            <Border x:Name="FavoriteBadge" Width="22" Height="22" Margin="6" CornerRadius="11"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                    Background="{StaticResource BadgeBrush}" ToolTipService.ToolTip="Favorite">
                <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource FavoriteBrush}" />
            </Border>
            <!-- Hover: dim the cover and offer Play (board 1). -->
            <Border x:Name="Overlay" CornerRadius="8" Background="{StaticResource CoverOverlayBrush}" Visibility="Collapsed">
                <Button x:Name="PlayButton" Style="{StaticResource CoverPlayButton}" Click="OnPlayClick">
                    <FontIcon Glyph="&#xF5B0;" FontSize="16" />
                </Button>
            </Border>
        </Grid>
        <TextBlock x:Name="TitleText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
