<UserControl x:Class="GameShelf.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:GameShelf.Views"
             AutomationProperties.Name="Game details">
    <UserControl.Resources>
        <!-- Buttons over the banner art: the panel's own icon buttons on a small acrylic surface (like Windows'
             media overlays), so they read on any image and look like the rest of the panel. -->
        <Style x:Key="OverlaySurface" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="0,0,0,24">
            <!-- Banner (Steam hero art, or generated art when there is none) -->
            <Grid Height="200">
                <v:CoverView x:Name="Banner" Kind="Hero" DecodeWidth="560" CornerRadius="0" />
                <Border Background="{StaticResource BannerScrimBrush}" IsHitTestVisible="False" />
                <!-- The game's logo (§13 a), or its title where it has none, on the banner right of the cover that
                     overlaps the banner's lower edge. Neither shows until the logo lookup is done (no swap). Over
                     the art, so the same light text in light and dark mode. -->
                <v:BannerLogo x:Name="Logo" MaxLogoHeight="72" MaxWidthShare="0.6" Margin="138,0,20,12" />
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" FontSize="26" Foreground="White"
                           Text="{x:Bind ViewModel.Title, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}"
                           Margin="138,0,20,10" VerticalAlignment="Bottom" MaxLines="2" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                <Border Style="{StaticResource OverlaySurface}" HorizontalAlignment="Left">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{x:Bind ViewModel.BackCommand}"
                            ToolTipService.ToolTip="Back to all games (Esc)" AutomationProperties.Name="Back to all games" />
                </Border>
                <Border Style="{StaticResource OverlaySurface}" HorizontalAlignment="Right">
                    <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Command="{x:Bind ViewModel.FavoriteCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}">
                        <FontIcon x:Name="FavoriteGlyph" FontSize="16" />
                    </Button>
                </Border>
            </Grid>

            <!-- The cover, overlapping the banner's lower edge, and the launcher line under the title -->
            <Grid Margin="20,-56,20,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="102" Height="134" Padding="3" CornerRadius="9"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <v:CoverView x:Name="Cover" DecodeWidth="96" CornerRadius="6" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,66,0,0" VerticalAlignment="Top" Spacing="4">
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="AntiCheatLabel" Padding="0" Margin="0,-2,0,0" Visibility="{x:Bind ViewModel.HasAntiCheat, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind ViewModel.AntiCheatLabelName, Mode=OneWay}"
                                     Click="OnAntiCheatLabelClick" ToolTipService.ToolTip="Show anti-cheat details">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="AntiCheatGlyph" FontSize="12" />
                            <TextBlock x:Name="AntiCheatLabelText" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.AntiCheatLabel, Mode=OneWay}" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </Grid>

            <!-- Actions -->
            <Grid Margin="20,20,20,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Height="44" FontSize="16"
                        HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.PlayCommand}"
                        AutomationProperties.Name="{x:Bind ViewModel.PlayName, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                        <TextBlock Text="Play" />
                    </StackPanel>
                </Button>
                <Button x:Name="FolderButton" Grid.Column="1" Width="44" Height="44" Padding="0" Command="{x:Bind ViewModel.FolderCommand}"
                        IsEnabled="{x:Bind ViewModel.HasFolder, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.FolderToolTip, Mode=OneWay}"
                        AutomationProperties.Name="Open install folder">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
                <Button x:Name="MoreButton" Grid.Column="2" Width="44" Height="44" Padding="0" Click="OnMoreClick"
                        ToolTipService.ToolTip="More" AutomationProperties.Name="More actions">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                </Button>
            </Grid>

            <!-- Stats -->
            <Grid Margin="20,16,20,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Playtime" />
                        <TextBlock x:Name="PlaytimeText" Style="{StaticResource StatValue}" Text="{x:Bind ViewModel.PlaytimeText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Last played" />
                        <TextBlock x:Name="LastPlayedText" Style="{StaticResource StatValue}" Text="{x:Bind ViewModel.LastPlayedText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Size on disk" />
                        <TextBlock x:Name="SizeText" Style="{StaticResource StatValue}" Text="{x:Bind ViewModel.SizeText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--
                Board 21: the playtime chart and the recent sessions share one "Activity" card; the per-game
                settings are one card each; launch options (with "Start with" and "Process to watch") and the
                anti-cheat check open from their card.
            -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="Activity" />
            <!-- A session's crash, opened from its "Details" link (milestone 11) -->
            <v:CrashCard x:Name="SessionCrash" Margin="20,0,20,8" Visibility="Collapsed" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Playtime chart: hours per week (8 weeks) or per month (12 months), from our own sessions -->
                    <StackPanel x:Name="PlaytimeSection" Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay}">
                        <StackPanel Padding="0,14,0,10" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PeriodTotalText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" Text="{x:Bind ViewModel.PeriodTotal, Mode=OneWay}" />
                                    <TextBlock x:Name="PeriodDetailText" Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.PeriodDetail, Mode=OneWay}" />
                                </StackPanel>
                                <SelectorBar x:Name="PeriodChoice" Grid.Column="1" VerticalAlignment="Center"
                                             AutomationProperties.Name="Chart period" SelectionChanged="OnPeriodChanged">
                                    <SelectorBarItem x:Name="WeeksItem" Text="8 weeks" IsSelected="True" />
                                    <SelectorBarItem x:Name="MonthsItem" Text="12 months" />
                                </SelectorBar>
                            </Grid>
                            <v:BarChart x:Name="PlaytimeChart" PlotHeight="88" BarWidth="14" />
                        </StackPanel>
                        <Border Style="{StaticResource RowDivider}" />
                    </StackPanel>
                    <!-- Recent sessions (tracked by the watcher) -->
                    <StackPanel x:Name="SessionsList" AutomationProperties.Name="Recent sessions" Padding="0,4" />
                    <TextBlock x:Name="NoSessionsText" Margin="0,14" Visibility="{x:Bind ViewModel.NoSessions, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="No sessions yet. Playtime is tracked when you start the game from the shelf." />
                </StackPanel>
            </Border>
            <TextBlock x:Name="CrashPatternText" Margin="24,6,20,0" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.CrashPattern, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasCrashPattern, Mode=OneWay}" />

            <!-- Per-game settings -->
            <TextBlock Style="{StaticResource GroupLabel}" Text="This game" />
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE916;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Hide delay" />
                    <ComboBox x:Name="HideDelayBox" Grid.Column="2" VerticalAlignment="Center" MinWidth="150"
                              AutomationProperties.Name="Hide delay" ItemsSource="{x:Bind ViewModel.HideDelayChoices, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedHideDelay, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16" ToolTipService.ToolTip="Optimizes Windows while this game runs (Settings › Game mode)">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7FC;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Game mode" />
                    <ComboBox x:Name="GameModeBox" Grid.Column="2" VerticalAlignment="Center" MinWidth="150"
                              AutomationProperties.Name="Game mode for this game" ItemsSource="{x:Bind ViewModel.GameModeChoices, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedGameMode, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xEB9F;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Cover image" />
                        <TextBlock x:Name="CoverText" Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.CoverText, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton x:Name="CoverButton" Grid.Column="2" Content="Change" VerticalAlignment="Center"
                                    AutomationProperties.Name="Change cover image">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Choose image…" Click="OnPickCover">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DefaultCoverItem" Text="Use default" Command="{x:Bind ViewModel.DefaultCoverCommand}"
                                                IsEnabled="{x:Bind ViewModel.HasCustomCover, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </Border>

            <!-- Launch options: engine suggestions, extra arguments, another exe to start with, the process to watch -->
            <Border x:Name="LaunchCard" Style="{StaticResource SettingCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE9E9;" />
                    <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Launch options" />
                        <TextBlock x:Name="LaunchSummaryText" Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.LaunchSummary, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.LaunchSummary, Mode=OneWay}" />
                    </StackPanel>
                    <Button x:Name="LaunchChevron" Grid.Column="2" Style="{StaticResource DisclosureButton}" />
                </Grid>
            </Border>
            <Border x:Name="LaunchBody" Style="{StaticResource SettingCardBody}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10" MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EngineText" Style="{StaticResource RowDetail}" VerticalAlignment="Center" Margin="0" Text="{x:Bind ViewModel.EngineText, Mode=OneWay}" />
                        <Border x:Name="EngineTag" Grid.Column="1" Padding="8,3,9,4" CornerRadius="10" BorderThickness="1"
                                AutomationProperties.Name="{x:Bind ViewModel.EngineTagName, Mode=OneWay}"
                                VerticalAlignment="Center" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="EngineGlyph" Glyph="&#xE7FC;" FontSize="11" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.EngineKnown, Mode=OneWay}"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="EngineTagText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Text="{x:Bind ViewModel.EngineTag, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="SuggestionList" AutomationProperties.Name="Suggested launch options" Visibility="{x:Bind ViewModel.HasSuggestions, Mode=OneWay}" />
                    <TextBox x:Name="ExtraArgsBox" Header="Extra arguments" PlaceholderText="For example -windowed"
                             MaxLength="1024" TextChanged="OnExtraArgsChanged" LostFocus="OnExtraArgsLostFocus"
                             AutomationProperties.Name="Extra arguments" IsSpellCheckEnabled="False" IsEnabled="{x:Bind ViewModel.LaunchSupported, Mode=OneWay}" />
                    <TextBlock x:Name="StartsAsText" Style="{StaticResource RowDetail}" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.StartsAs, Mode=OneWay}"
                               TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock x:Name="LaunchNoteText" Style="{StaticResource RowDetail}" Visibility="{x:Bind ViewModel.HasLaunchNote, Mode=OneWay}"
                               Text="{x:Bind ViewModel.LaunchNote, Mode=OneWay}"
                               TextWrapping="Wrap" TextTrimming="None" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                        <Button x:Name="TestLaunchButton" Content="Test launch" Command="{x:Bind ViewModel.TestLaunchCommand}"
                                IsEnabled="{x:Bind ViewModel.CanTestLaunch, Mode=OneWay}"
                                ToolTipService.ToolTip="Start the game with these options and keep Game Shelf open" />
                        <Button x:Name="ResetLaunchButton" Content="Reset" Command="{x:Bind ViewModel.ResetLaunchCommand}"
                                IsEnabled="{x:Bind ViewModel.CanResetLaunch, Mode=OneWay}"
                                ToolTipService.ToolTip="Start the game the normal way again" />
                    </StackPanel>
                    <Border Style="{StaticResource RowDivider}" Margin="0,0,-16,0" />
                    <Grid Style="{StaticResource SettingRow}" MinHeight="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Start with" />
                            <TextBlock x:Name="StartWithText" Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.StartWithText, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.StartWithToolTip, Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton x:Name="StartWithButton" Grid.Column="1" Content="Change" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanPickStartWith, Mode=OneWay}"
                                        AutomationProperties.Name="Change the program to start with">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Choose program…" Click="OnPickStartWith">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="AutoStartWithItem" Text="Automatic" Command="{x:Bind ViewModel.AutoStartWithCommand}"
                                                    IsEnabled="{x:Bind ViewModel.HasStartWith, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" Margin="0,0,-16,0" />
                    <Grid Style="{StaticResource SettingRow}" MinHeight="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Process to watch" />
                            <TextBlock x:Name="ProcessText" Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.ProcessText, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.ProcessToolTip, Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton x:Name="ProcessButton" Grid.Column="1" Content="Change" VerticalAlignment="Center"
                                        AutomationProperties.Name="Change process to watch">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Choose program…" Click="OnPickProcess">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="AutoProcessItem" Text="Use auto-detect" Command="{x:Bind ViewModel.AutoProcessCommand}"
                                                    IsEnabled="{x:Bind ViewModel.HasCustomProcess, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Anti-cheat: what the game uses, what it needs from this PC, and programs it may refuse to run next to.
                 Closed when all is well, open when something needs attention. -->
            <StackPanel x:Name="AntiCheatSection" Visibility="{x:Bind ViewModel.HasAntiCheat, Mode=OneWay}">
                <Border x:Name="AntiCheatCard" Style="{StaticResource SettingCard}" AutomationProperties.Name="{x:Bind ViewModel.AntiCheatCardName, Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xEA18;" />
                        <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Anti-cheat" />
                            <TextBlock x:Name="AntiCheatNames" Style="{StaticResource RowDetail}" Text="{x:Bind ViewModel.AntiCheatNames, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="AntiCheatStateGlyph" FontSize="14" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.Checked, Mode=OneWay}" />
                            <TextBlock x:Name="AntiCheatStateText" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.AntiCheatState, Mode=OneWay}" />
                        </StackPanel>
                        <Button x:Name="AntiCheatChevron" Grid.Column="3" Style="{StaticResource DisclosureButton}" />
                    </Grid>
                </Border>
                <Border x:Name="AntiCheatBody" Style="{StaticResource SettingCardBody}">
                    <StackPanel Spacing="10">
                        <StackPanel x:Name="RequirementList" Spacing="6" AutomationProperties.Name="Requirements" />
                        <StackPanel x:Name="ConflictList" Spacing="6" AutomationProperties.Name="Programs that may conflict" />
                        <CheckBox x:Name="RemindCheck" Content="Remind me before launching" IsChecked="{x:Bind ViewModel.AntiCheatReminder, Mode=TwoWay}"
                                  ToolTipService.ToolTip="When you press Play, offer to close programs this anti-cheat may refuse to run next to" />
                        <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Requirements can change with game updates. Game Shelf only checks these settings and never changes them." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Links -->
            <StackPanel Orientation="Horizontal" Margin="8,16,20,0">
                <!-- Opens the store in the browser, so it carries the "opens outside the app" glyph. -->
                <HyperlinkButton x:Name="StoreLink" Command="{x:Bind ViewModel.StoreCommand}" AutomationProperties.Name="Store page"
                                 Visibility="{x:Bind ViewModel.HasStorePage, Mode=OneWay}"
                                 ToolTipService.ToolTip="Opens in your browser">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Store page" />
                        <FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </HyperlinkButton>
                <HyperlinkButton Content="Hide from shelf" Command="{x:Bind ViewModel.HideCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
