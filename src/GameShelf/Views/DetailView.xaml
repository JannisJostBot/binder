<UserControl x:Class="GameShelf.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:GameShelf.Views"
             AutomationProperties.Name="Game details">
    <UserControl.Resources>
        <!-- Buttons over the banner art: the panel's own icon buttons on a small acrylic surface (like Windows'
             media overlays), so they read on any image and look like the rest of the panel. -->
        <Style x:Key="OverlaySurface" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="0,0,0,24">
            <!-- Banner (Steam hero art, or generated art when there is none) -->
            <Grid Height="200">
                <v:CoverView x:Name="Banner" Kind="Hero" DecodeWidth="560" CornerRadius="0" />
                <Border Style="{StaticResource OverlaySurface}" HorizontalAlignment="Left">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="OnBackClick"
                            ToolTipService.ToolTip="Back to all games (Esc)" AutomationProperties.Name="Back to all games" />
                </Border>
                <Border Style="{StaticResource OverlaySurface}" HorizontalAlignment="Right">
                    <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Click="OnFavoriteClick">
                        <FontIcon x:Name="FavoriteGlyph" FontSize="16" />
                    </Button>
                </Border>
            </Grid>

            <!-- Cover and title, overlapping the banner's lower edge -->
            <Grid Margin="20,-56,20,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="102" Height="134" Padding="3" CornerRadius="9"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <v:CoverView x:Name="Cover" DecodeWidth="96" CornerRadius="6" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,0,4" VerticalAlignment="Bottom" Spacing="4">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" FontSize="24"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="AntiCheatLabel" Padding="0" Margin="0,-2,0,0" Visibility="Collapsed"
                                     Click="OnAntiCheatLabelClick" ToolTipService.ToolTip="Show anti-cheat details">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="AntiCheatGlyph" FontSize="12" />
                            <TextBlock x:Name="AntiCheatLabelText" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </Grid>

            <!-- Actions -->
            <Grid Margin="20,20,20,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Height="44" FontSize="16"
                        HorizontalAlignment="Stretch" Click="OnPlayClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                        <TextBlock Text="Play" />
                    </StackPanel>
                </Button>
                <Button x:Name="FolderButton" Grid.Column="1" Width="44" Height="44" Padding="0" Click="OnFolderClick"
                        ToolTipService.ToolTip="Open install folder" AutomationProperties.Name="Open install folder">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
                <Button x:Name="MoreButton" Grid.Column="2" Width="44" Height="44" Padding="0" Click="OnMoreClick"
                        ToolTipService.ToolTip="More" AutomationProperties.Name="More actions">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                </Button>
            </Grid>

            <!-- Stats -->
            <Grid Margin="20,16,20,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Playtime" />
                        <TextBlock x:Name="PlaytimeText" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Last played" />
                        <TextBlock x:Name="LastPlayedText" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Size on disk" />
                        <TextBlock x:Name="SizeText" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Playtime chart: hours per week (8 weeks) or per month (12 months), from our own sessions -->
            <StackPanel x:Name="PlaytimeSection" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionLabel}" Text="Playtime" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Padding="0,10,0,10" Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PeriodTotalText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                                <TextBlock x:Name="PeriodDetailText" Style="{StaticResource RowDetail}" />
                            </StackPanel>
                            <SelectorBar x:Name="PeriodChoice" Grid.Column="1" VerticalAlignment="Center"
                                         AutomationProperties.Name="Chart period" SelectionChanged="OnPeriodChanged">
                                <SelectorBarItem x:Name="WeeksItem" Text="8 weeks" IsSelected="True" />
                                <SelectorBarItem x:Name="MonthsItem" Text="12 months" />
                            </SelectorBar>
                        </Grid>
                        <v:BarChart x:Name="PlaytimeChart" PlotHeight="88" BarWidth="14" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Recent sessions (tracked by the watcher) -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="Recent sessions" />
            <!-- A session's crash, opened from its "Details" link (milestone 11) -->
            <v:CrashCard x:Name="SessionCrash" Margin="20,0,20,8" Visibility="Collapsed" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel x:Name="SessionsList" AutomationProperties.Name="Recent sessions" />
                    <TextBlock x:Name="NoSessionsText" Margin="0,14" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="No sessions yet. Playtime is tracked when you start the game from the shelf." />
                </StackPanel>
            </Border>
            <TextBlock x:Name="CrashPatternText" Margin="4,6,0,0" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

            <!-- Per-game settings -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="This game only" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowTitle}" Text="Hide delay" />
                        <ComboBox x:Name="HideDelayBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="150"
                                  AutomationProperties.Name="Hide delay" SelectionChanged="OnHideDelayChanged" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Process to watch" />
                            <TextBlock x:Name="ProcessText" Style="{StaticResource RowDetail}" />
                        </StackPanel>
                        <DropDownButton x:Name="ProcessButton" Grid.Column="1" Content="Change" VerticalAlignment="Center"
                                        AutomationProperties.Name="Change process to watch">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Choose program…" Click="OnPickProcess">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="AutoProcessItem" Text="Use auto-detect" Click="OnAutoProcess">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Cover image" />
                            <TextBlock x:Name="CoverText" Style="{StaticResource RowDetail}" />
                        </StackPanel>
                        <DropDownButton x:Name="CoverButton" Grid.Column="1" Content="Change" VerticalAlignment="Center"
                                        AutomationProperties.Name="Change cover image">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Choose image…" Click="OnPickCover">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="DefaultCoverItem" Text="Use default" Click="OnDefaultCover">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Launch options: engine suggestions, extra arguments, another exe to start with -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="Launch options" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Start with" />
                            <TextBlock x:Name="StartWithText" Style="{StaticResource RowDetail}" />
                        </StackPanel>
                        <DropDownButton x:Name="StartWithButton" Grid.Column="1" Content="Change" VerticalAlignment="Center"
                                        AutomationProperties.Name="Change the program to start with">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Choose program…" Click="OnPickStartWith">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="AutoStartWithItem" Text="Automatic" Click="OnAutoStartWith">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <StackPanel Padding="0,12" Spacing="8">
                        <Grid ColumnSpacing="10" MinHeight="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowTitle}" Text="Engine" VerticalAlignment="Center" />
                            <Border x:Name="EngineTag" Grid.Column="1" Padding="8,3,9,4" CornerRadius="10" BorderThickness="1"
                                    VerticalAlignment="Center" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="EngineGlyph" Glyph="&#xE7FC;" FontSize="11" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="EngineTagText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="EngineText" Style="{StaticResource RowDetail}" Margin="0,6,0,0" />

                        <StackPanel x:Name="SuggestionList" AutomationProperties.Name="Suggested launch options" />
                        <TextBox x:Name="ExtraArgsBox" Header="Extra arguments" PlaceholderText="For example -windowed"
                                 MaxLength="1024" TextChanged="OnExtraArgsChanged" LostFocus="OnExtraArgsLostFocus"
                                 AutomationProperties.Name="Extra arguments" IsSpellCheckEnabled="False" />
                        <TextBlock x:Name="StartsAsText" Style="{StaticResource RowDetail}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="LaunchNoteText" Style="{StaticResource RowDetail}" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="TestLaunchButton" Content="Test launch" Click="OnTestLaunchClick"
                                    ToolTipService.ToolTip="Start the game with these options and keep Game Shelf open" />
                            <Button x:Name="ResetLaunchButton" Content="Reset" Click="OnResetLaunchClick"
                                    ToolTipService.ToolTip="Start the game the normal way again" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Anti-cheat: what the game uses, what it needs from this PC, and programs it may refuse to run next to -->
            <StackPanel x:Name="AntiCheatSection" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionLabel}" Text="Anti-cheat" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Padding="0,12" Spacing="10">
                        <TextBlock x:Name="AntiCheatNames" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <StackPanel x:Name="RequirementList" Spacing="6" AutomationProperties.Name="Requirements" />
                        <StackPanel x:Name="ConflictList" Spacing="6" AutomationProperties.Name="Programs that may conflict" />
                        <CheckBox x:Name="RemindCheck" Content="Remind me before launching" Click="OnRemindClick"
                                  ToolTipService.ToolTip="When you press Play, offer to close programs this anti-cheat may refuse to run next to" />
                        <TextBlock Style="{StaticResource RowDetail}" TextWrapping="Wrap"
                                   Text="Requirements can change with game updates. Game Shelf only checks these settings and never changes them." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Links -->
            <StackPanel Orientation="Horizontal" Margin="8,16,20,0">
                <!-- Opens the store in the browser, so it carries the "opens outside the app" glyph. -->
                <HyperlinkButton x:Name="StoreLink" Click="OnStoreClick" AutomationProperties.Name="Store page"
                                 ToolTipService.ToolTip="Opens in your browser">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Store page" />
                        <FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </HyperlinkButton>
                <HyperlinkButton Content="Hide from shelf" Click="OnHideClick" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
