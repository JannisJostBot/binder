<UserControl x:Class="GameShelf.Views.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:GameShelf"
             xmlns:v="using:GameShelf.Views">
    <Grid Padding="20,20,20,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: a greeting for the time of day (board 14). The game count is above the grid. -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1" />
            <!-- Flyout only: keep it open when clicking elsewhere (board 6). -->
            <ToggleButton x:Name="PinButton" Grid.Column="1" Style="{StaticResource IconToggleButton}" Content="&#xE718;"
                          Command="{x:Bind ViewModel.PinCommand}" Visibility="{x:Bind ViewModel.PinVisible, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.PinChecked, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.PinLabel, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.PinLabel, Mode=OneWay}" />
            <!-- While Game mode is on: a checked toggle (accent fill, like a Quick Settings tile) that turns it off.
                 A state, not a badge, so it doesn't read as a notification. -->
            <ToggleButton x:Name="GameModeButton" Grid.Column="2" Style="{StaticResource IconToggleButton}" Content="&#xE7FC;"
                          IsChecked="{x:Bind ViewModel.GameModeOn, Mode=OneWay}" Visibility="{x:Bind ViewModel.GameModeOn, Mode=OneWay}"
                          Click="OnGameModeButtonClick"
                          ToolTipService.ToolTip="{x:Bind s:Strings.GameModeOnToolTip}" AutomationProperties.Name="{x:Bind s:Strings.GameMode}" />
            <!-- Quick actions (§16, board 18). The menu's items are made when it opens. -->
            <Button x:Name="ActionsButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE712;"
                    ToolTipService.ToolTip="{x:Bind s:Strings.MoreActions}" AutomationProperties.Name="{x:Bind s:Strings.MoreActions}"
                    KeyboardAcceleratorPlacementMode="Hidden">
                <Button.Flyout>
                    <MenuFlyout x:Name="ActionsMenu" Placement="BottomEdgeAlignedRight" Opening="OnActionsMenuOpening" />
                </Button.Flyout>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="G" Invoked="OnGameModeAccelerator" />
                    <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE713;" Command="{x:Bind ViewModel.SettingsCommand}"
                    ToolTipService.ToolTip="{x:Bind s:Strings.Settings}" AutomationProperties.Name="{x:Bind s:Strings.Settings}" />
        </Grid>

        <!-- The Game mode helper notice shares the search box's row, so the rows' spacing stays the same while
             it's closed. -->
        <StackPanel Grid.Row="1" Spacing="14">
            <InfoBar x:Name="HelperBar" Title="{x:Bind s:Strings.HelperBarTitle}" IsOpen="{x:Bind ViewModel.HelperBarOpen, Mode=OneWay}" Severity="Informational"
                     Message="{x:Bind s:Strings.HelperBarMessage}"
                     Closed="OnHelperBarClosed">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind s:Strings.UpdateEllipsis}" Click="OnHelperUpdateClick" IsEnabled="{x:Bind ViewModel.HelperUpdateEnabled, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="{x:Bind ViewModel.Placeholder, Mode=OneWay}" QueryIcon="Find"
                            AutomationProperties.Name="{x:Bind s:Strings.SearchGames}" TextChanged="OnSearchChanged"
                            PreviewKeyDown="OnSearchKeyDown" />
        </StackPanel>

        <!-- After a crash (milestone 11, board 13) the crash card takes the top slot until it's dismissed. -->
        <v:CrashCard x:Name="Crash" Grid.Row="2" Visibility="{x:Bind ViewModel.CrashVisible, Mode=OneWay}" />

        <!-- One fixed-height slot (board 16): the "Continue playing" hero banner or "This week", switched in the
             corner and remembered, so switching never moves the grid. Hidden while searching. -->
        <Grid x:Name="Spotlight" Grid.Row="2" Height="168" CornerRadius="{ThemeResource OverlayCornerRadius}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.SpotlightVisible, Mode=OneWay}">
            <Grid Visibility="{x:Bind ViewModel.ContinueVisible, Mode=OneWay}">
                <!-- The hero art loads only while this pane is shown (ShelfView.UpdateSpotlight). -->
                <v:CoverView x:Name="ContinueArt" Kind="Hero" DecodeWidth="520" CornerRadius="0" />
                <Border Background="{StaticResource BannerScrimBrush}" />
                <!-- Over the art, so the same light text in light and dark mode (like the cover badges). -->
                <Grid Margin="16,0,16,14" VerticalAlignment="Bottom" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom" Spacing="0">
                        <!-- "Continue playing", or "Welcome back" once after a session (§13 c). -->
                        <TextBlock Text="{x:Bind ViewModel.ContinueEyebrow, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource BannerSecondaryTextBrush}" />
                        <!-- The game's logo instead of its title when Steam has one (§13 a). -->
                        <v:BannerLogo x:Name="ContinueLogo" MaxLogoHeight="56" Margin="0,4,0,4" />
                        <TextBlock x:Name="ContinueTitle" Text="{x:Bind ViewModel.ContinueTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="22"
                                   Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.ContinueDetail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource BannerSecondaryTextBrush}" />
                        <!-- A quiet playtime milestone ("100 hours in …", §13 e), only in "Welcome back". -->
                        <TextBlock Text="{x:Bind ViewModel.ContinueMilestone, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind ViewModel.MilestoneVisible, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ContinuePlayCommand}"
                            AutomationProperties.Name="{x:Bind ViewModel.ContinuePlayName, Mode=OneWay}"
                            VerticalAlignment="Bottom" Padding="18,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xF5B0;" FontSize="12" />
                            <TextBlock Text="{x:Bind s:Strings.Play}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
            <!-- Total top-left (the switch sits top-right), the chart in its own full-width row below, so the two
                 never meet. -->
            <Grid Padding="16,12,16,10" RowSpacing="6" Visibility="{x:Bind ViewModel.ShowWeek, Mode=OneWay}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,230,0" Spacing="0">
                    <TextBlock Text="{x:Bind ViewModel.WeekTotal, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="24" />
                    <TextBlock x:Name="WeekDetail" Text="{x:Bind ViewModel.WeekDetail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <v:BarChart x:Name="WeekChart" Grid.Row="1" PlotHeight="44" BarWidth="16" VerticalAlignment="Bottom" />
            </Grid>
            <!-- The switch: WinUI's own SelectorBar (like the filters), on a solid surface so it reads over any art.
                 Shown only when both sides have something to show. -->
            <Border Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Visibility="{x:Bind ViewModel.SwitchVisible, Mode=OneWay}">
                <!-- Compact, as on board 16: 12 px text, ~11 px icons (the template draws icons at 0.8 of their
                     size), 28 px items with the selection pill, and a subtle fill on the selected one. -->
                <SelectorBar x:Name="SpotlightSwitch" Padding="2" AutomationProperties.Name="{x:Bind s:Strings.TopCard}" SelectionChanged="OnSpotlightChanged">
                    <SelectorBar.Resources>
                        <StaticResource x:Key="SelectorBarItemBackgroundSelected" ResourceKey="SubtleFillColorSecondaryBrush" />
                        <Style TargetType="SelectorBarItem">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="10,5,10,3" />
                        </Style>
                    </SelectorBar.Resources>
                    <SelectorBarItem x:Name="ContinueItem" Text="{x:Bind s:Strings.SpotlightContinue}">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="WeekItem" Text="{x:Bind s:Strings.ThisWeek}">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE9D2;" FontSize="14" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
            </Border>
        </Grid>

        <!-- One toolbar row right above the grid it acts on (owner's choice, law of proximity): the filters (All,
             Favorites, Recent, then the launchers that have games, the rest under More; built in code) and the sort
             menu (board 7) as a compact icon button. The game count is in the search box's placeholder. -->
        <Grid Grid.Row="3" ColumnSpacing="8" Margin="-12,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- LB and RB beside the filters while a controller is in use (board 3). -->
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource PadPill}" Margin="12,0,0,0" Visibility="{x:Bind ViewModel.PadMode, Mode=OneWay}">
                    <TextBlock Text="LB" Style="{StaticResource PadPillText}" />
                </Border>
                <SelectorBar x:Name="Filters" AutomationProperties.Name="{x:Bind s:Strings.Filter}" SelectionChanged="OnFilterChanged" />
                <Border Style="{StaticResource PadPill}" Visibility="{x:Bind ViewModel.PadMode, Mode=OneWay}">
                    <TextBlock Text="RB" Style="{StaticResource PadPillText}" />
                </Border>
            </StackPanel>
            <DropDownButton x:Name="MoreFilters" Grid.Column="1" Content="{x:Bind s:Strings.More}" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind s:Strings.MoreLaunchers}" Visibility="{x:Bind ViewModel.MoreVisible, Mode=OneWay}">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton x:Name="SortButton" Grid.Column="3" VerticalAlignment="Center" Padding="8,6"
                            Visibility="{x:Bind ViewModel.SortVisible, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.SortName, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.SortName, Mode=OneWay}"
                            Background="Transparent" BorderBrush="Transparent">
                <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Cover grid and list view. Both virtualize; only the visible one has items. -->
        <Grid Grid.Row="4" Margin="-6,0,-6,0">
            <GridView x:Name="Tiles" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                      AutomationProperties.Name="{x:Bind s:Strings.Games}" ContainerContentChanging="OnTileContentChanging"
                      PreviewKeyDown="OnGridKeyDown" ContextRequested="OnItemContextRequested"
                      GotFocus="OnTilesGotFocus" LostFocus="OnTilesLostFocus"
                      IsSwipeEnabled="False" CanDragItems="False">
                <!-- The tile draws its own hover (lift, shadow, fade, "Play"), so the item's fill would only show
                     as a second box with other corners behind it. -->
                <GridView.Resources>
                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent" />
                </GridView.Resources>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Half a screen of tiles above and below the view (the default is two screens each way,
                             which realized and decoded every cover of a 70-game library on each open). -->
                        <ItemsWrapGrid Orientation="Horizontal" CacheLength="1" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="6" />
                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <v:GameTile />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <ListView x:Name="Rows" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                      AutomationProperties.Name="{x:Bind s:Strings.Games}" ContainerContentChanging="OnRowContentChanging"
                      PreviewKeyDown="OnGridKeyDown" ContextRequested="OnItemContextRequested"
                      Visibility="Collapsed" CanDragItems="False">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel CacheLength="1" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="Margin" Value="6,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <v:GameRow />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Margin="24,48,24,24" MaxWidth="360" Visibility="{x:Bind ViewModel.EmptyVisible, Mode=OneWay}" HorizontalAlignment="Center" Spacing="12">
                <!-- A large Fluent icon, one plain sentence and, where it helps, the way forward (board 14). -->
                <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <FontIcon Glyph="{x:Bind ViewModel.EmptyGlyph, Mode=OneWay}" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- Nothing found: the ways to add games. No search match: clear it, or add the game. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"
                            Margin="0,4,0,0" Visibility="{x:Bind ViewModel.EmptyActionsVisible, Mode=OneWay}">
                    <Button Content="{x:Bind s:Strings.ClearSearch}" Click="OnEmptyClearClick" Visibility="{x:Bind ViewModel.EmptyClearVisible, Mode=OneWay}" />
                    <Button Content="{x:Bind s:Strings.ImportShortcuts}" Command="{x:Bind ViewModel.ImportCommand}"
                            Visibility="{x:Bind ViewModel.EmptyImportVisible, Mode=OneWay}" />
                    <Button Content="{x:Bind s:Strings.AddGame}" Command="{x:Bind ViewModel.AddGameCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Footer hint: teaches hide and return during the first few games, then steps aside (ShelfView.SetData). -->
        <Grid Grid.Row="5" ColumnSpacing="8" Visibility="{x:Bind ViewModel.FooterVisible, Mode=OneWay}" Padding="0,12,0,0" BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xED1A;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.FooterText, Mode=OneWay}" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Controller hints (board 3), in the footer's place while a controller is in use. -->
        <StackPanel x:Name="PadHints" Grid.Row="5" Orientation="Horizontal" Spacing="16" Padding="0,12,0,0"
                    BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="{x:Bind ViewModel.PadMode, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind s:Strings.PadHintsName}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Style="{StaticResource PadKey}"><TextBlock Text="A" Style="{StaticResource PadKeyText}" /></Border>
                <TextBlock Text="{x:Bind s:Strings.Play}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Style="{StaticResource PadKey}"><TextBlock Text="X" Style="{StaticResource PadKeyText}" /></Border>
                <TextBlock Text="{x:Bind s:Strings.Details}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Style="{StaticResource PadKey}"><TextBlock Text="Y" Style="{StaticResource PadKeyText}" /></Border>
                <TextBlock Text="{x:Bind s:Strings.Favorite}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.BackHintVisible, Mode=OneWay}">
                <Border Style="{StaticResource PadKey}"><TextBlock Text="B" Style="{StaticResource PadKeyText}" /></Border>
                <TextBlock Text="{x:Bind s:Strings.Close}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- The Menu button's three lines (Segoe Fluent "GlobalNavigationButton"). -->
                <Border Style="{StaticResource PadKey}"><FontIcon Glyph="&#xE700;" FontSize="10" /></Border>
                <TextBlock Text="{x:Bind s:Strings.Settings}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
