<UserControl x:Class="GameShelf.Views.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:GameShelf.Views"
             AutomationProperties.Name="Game shelf">
    <Grid Padding="20,20,20,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Games" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" Grid.Column="1" Margin="8,2,0,0" VerticalAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <!-- Flyout only: keep it open when clicking elsewhere (board 6). -->
            <ToggleButton x:Name="PinButton" Grid.Column="2" Style="{StaticResource IconToggleButton}" Content="&#xE718;"
                          Click="OnPinClick" Visibility="Collapsed" />
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE713;" Click="OnSettingsClick"
                    ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings" />
        </Grid>

        <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Search games" QueryIcon="Find"
                        AutomationProperties.Name="Search games" TextChanged="OnSearchChanged"
                        PreviewKeyDown="OnSearchKeyDown" />

        <!-- Filters: All, Favorites, Recent, then the launchers that have games; the rest under More. Built in code. -->
        <Grid Grid.Row="2" ColumnSpacing="8" Margin="-12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Filters" AutomationProperties.Name="Filter" SelectionChanged="OnFilterChanged" />
            <DropDownButton x:Name="MoreFilters" Grid.Column="1" Content="More" VerticalAlignment="Center"
                            AutomationProperties.Name="More launchers" Visibility="Collapsed">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Continue playing, then this week's playtime (both hidden while searching) -->
        <StackPanel Grid.Row="3" Spacing="10">
        <Border x:Name="ContinueCard" Padding="12" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <v:CoverView x:Name="ContinueCover" Width="72" Height="96" DecodeWidth="72" CornerRadius="6" />
                    <TextBlock x:Name="ContinuePlaceholder" Margin="6" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Continue playing" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ContinueTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ContinueDetail" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="ContinuePlay" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnContinuePlayClick"
                        VerticalAlignment="Center" Padding="16,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xF5B0;" FontSize="12" />
                        <TextBlock Text="Play" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <Border x:Name="WeekCard" Padding="14,10,14,8" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="This week" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="WeekTotal" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                    <TextBlock x:Name="WeekDetail" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <v:BarChart x:Name="WeekChart" Grid.Column="1" PlotHeight="40" BarWidth="10" VerticalAlignment="Center" />
            </Grid>
        </Border>
        </StackPanel>
        <!-- Count and sort (board 7) -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VisibleCountText" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <DropDownButton x:Name="SortButton" Grid.Column="1" AutomationProperties.Name="Sort"
                            ToolTipService.ToolTip="Sort" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    <TextBlock x:Name="SortText" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Cover grid and list view. Both virtualize; only the visible one has items. -->
        <Grid Grid.Row="5" Margin="-6,0,-6,0">
            <GridView x:Name="Tiles" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                      AutomationProperties.Name="Games" ContainerContentChanging="OnTileContentChanging"
                      PreviewKeyDown="OnGridKeyDown" ContextRequested="OnItemContextRequested"
                      IsSwipeEnabled="False" CanDragItems="False">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <v:GameTile />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <ListView x:Name="Rows" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                      AutomationProperties.Name="Games" ContainerContentChanging="OnRowContentChanging"
                      PreviewKeyDown="OnGridKeyDown" ContextRequested="OnItemContextRequested"
                      Visibility="Collapsed" CanDragItems="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="Margin" Value="6,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <v:GameRow />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" Margin="6,24" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="16">
                <TextBlock x:Name="EmptyText" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- First run with nothing found: offer the two ways to add games. -->
                <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"
                            Visibility="Collapsed">
                    <Button Content="Import desktop shortcuts" Click="OnEmptyImportClick" />
                    <Button Content="Add a game" Click="OnEmptyAddClick" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Footer hint -->
        <Grid Grid.Row="6" ColumnSpacing="8" Padding="0,12,0,0" BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xED1A;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="FooterText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
