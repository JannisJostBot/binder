<UserControl x:Class="GameShelf.Views.ModePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
    <!-- A small picture of the desktop in each display mode: wallpaper, an app window, the taskbar and the panel.
         Drawn in a fixed 200 x 120 space and scaled to fit. Static shapes only, theme brushes follow Windows live. -->
    <UserControl.Resources>
        <Style x:Key="Cover" TargetType="Border">
            <Setter Property="Height" Value="13" />
            <Setter Property="CornerRadius" Value="1.5" />
        </Style>
        <Style x:Key="AppWindow" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Width" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        </Style>
        <!-- The panel's contents: a title, the search box and a few covers. -->
        <ControlTemplate x:Key="MiniShelf" TargetType="ContentControl">
            <StackPanel Spacing="3">
                <Border Width="16" Height="3" HorizontalAlignment="Left" CornerRadius="1"
                        Background="{ThemeResource TextFillColorPrimaryBrush}" />
                <Border Height="5" CornerRadius="1" Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderThickness="0,0,0,0.5" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
                <Grid ColumnSpacing="2.5" RowSpacing="2.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Cover}" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Border Style="{StaticResource Cover}" Grid.Column="1" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                    <Border Style="{StaticResource Cover}" Grid.Column="2" Background="{ThemeResource AccentFillColorSecondaryBrush}" />
                    <Border Style="{StaticResource Cover}" Grid.Row="1" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                    <Border Style="{StaticResource Cover}" Grid.Row="1" Grid.Column="1" Background="{ThemeResource AccentFillColorTertiaryBrush}" />
                    <Border Style="{StaticResource Cover}" Grid.Row="1" Grid.Column="2" Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                    <Border Style="{StaticResource Cover}" Grid.Row="2" Background="{ThemeResource AccentFillColorSecondaryBrush}" />
                    <Border Style="{StaticResource Cover}" Grid.Row="2" Grid.Column="1" Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                    <Border Style="{StaticResource Cover}" Grid.Row="2" Grid.Column="2" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                </Grid>
            </StackPanel>
        </ControlTemplate>
        <Style x:Key="TaskbarIcon" TargetType="Border">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Background" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="200" Height="120" CornerRadius="6">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorDark1}" />
                    <GradientStop Offset="1" Color="{ThemeResource SystemAccentColorDark3}" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
            </Grid.RowDefinitions>

            <!-- Flyout: an app window, the panel slid out above the tray icon, in front of everything. -->
            <Grid x:Name="FlyoutScene">
                <Border Style="{StaticResource AppWindow}" Margin="10,8,46,12" />
                <Border Style="{StaticResource Panel}" Margin="0,10,5,4">
                    <ContentControl Template="{StaticResource MiniShelf}" />
                </Border>
            </Grid>

            <!-- On the desktop: the panel docked on the wallpaper, an app window in front of it. -->
            <Grid x:Name="DesktopScene" Visibility="Collapsed">
                <Border Style="{StaticResource Panel}" Margin="0,5,5,5">
                    <ContentControl Template="{StaticResource MiniShelf}" />
                </Border>
                <Border Style="{StaticResource AppWindow}" Margin="18,14,32,16" />
            </Grid>

            <!-- Taskbar: centered icons, the tray on the right. -->
            <Border Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderThickness="0,0.5,0,0" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                        <Border Style="{StaticResource TaskbarIcon}" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border Style="{StaticResource TaskbarIcon}" />
                        <Border Style="{StaticResource TaskbarIcon}" />
                        <Border Style="{StaticResource TaskbarIcon}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,7,0" Spacing="3">
                        <Border x:Name="TrayIcon" Style="{StaticResource TaskbarIcon}" Width="4" Height="4"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border Width="14" Height="3" CornerRadius="1" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
