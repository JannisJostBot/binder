<?xml version="1.0" encoding="utf-8"?>
<!-- The crash card (milestone 11, board 13): after a game crashed, closed unexpectedly or didn't start. Shown in
     the shelf's top slot when the widget comes back, and in a game's details for a past session. -->
<UserControl
    x:Class="GameShelf.Views.CrashCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:GameShelf">
    <Border Padding="16" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7BA;" FontSize="18" Margin="0,2,0,0" VerticalAlignment="Top"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ExplanationText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!-- Restart if it crashes (spec §17) gave up after two restarts in a row. -->
                    <TextBlock x:Name="RestartLimitText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind s:Strings.RestartLimit}"
                               Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="DismissButton" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="8" VerticalAlignment="Top"
                        Click="OnDismissClick" AutomationProperties.Name="{x:Bind s:Strings.Dismiss}" ToolTipService.ToolTip="{x:Bind s:Strings.Dismiss}">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <!-- What happened / Where / Also at that time / When, filled in code -->
            <Border Padding="12,10" CornerRadius="{ThemeResource ControlCornerRadius}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid x:Name="DetailsGrid" ColumnSpacing="12" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PlayAgainButton" AutomationProperties.Name="{x:Bind s:Strings.PlayAgain}" Style="{StaticResource AccentButtonStyle}" Click="OnPlayAgainClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xF5B0;" FontSize="12" />
                            <TextBlock Text="{x:Bind s:Strings.PlayAgain}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogButton" Content="{x:Bind s:Strings.OpenGameLog}" Click="OnLogClick"
                            ToolTipService.ToolTip="{x:Bind s:Strings.OpenGameLogToolTip}" />
                    <HyperlinkButton x:Name="RedistLink" Content="{x:Bind s:Strings.GetRedist}"
                                     ToolTipService.ToolTip="{x:Bind s:Strings.GetRedistToolTip}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ReportButton" AutomationProperties.Name="{x:Bind s:Strings.CopyReport}" Click="OnReportClick"
                            ToolTipService.ToolTip="{x:Bind s:Strings.CopyReportToolTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="{x:Bind s:Strings.CopyReport}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PromptButton" AutomationProperties.Name="{x:Bind s:Strings.CopyPrompt}" Click="OnPromptClick"
                            ToolTipService.ToolTip="{x:Bind s:Strings.CopyPromptToolTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="{x:Bind s:Strings.CopyPrompt}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- What was copied, so the user sees what they paste -->
            <StackPanel x:Name="CopiedPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock x:Name="CopiedNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Padding="12,10" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <TextBlock x:Name="CopiedText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
