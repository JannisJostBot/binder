<Window x:Class="GameShelf.Views.RestoredToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Shelf">
    <!-- Game mode's "Restored" toast (board 4): like the volume flyout, centered above the taskbar. The window is
         sized to this content once it has been laid out. -->
    <Grid x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Top" Height="52" Padding="16,0,10,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="Icon" Glyph="&#xEA18;" FontSize="20" VerticalAlignment="Center"
                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock x:Name="Message" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,1"
                   Style="{StaticResource BodyTextBlockStyle}" AutomationProperties.LiveSetting="Assertive" />
        <Button x:Name="DetailsButton" Grid.Column="2" Content="Details" VerticalAlignment="Center" Visibility="Collapsed"
                Click="OnDetailsClick" ToolTipService.ToolTip="Open the Game mode log"
                AutomationProperties.Name="Details: open the Game mode log" />
        <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" Visibility="Collapsed"
                Click="OnCloseClick" ToolTipService.ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
    </Grid>
</Window>
