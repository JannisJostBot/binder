<Window x:Class="GameShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:GameShelf.Views"
        Title="Game Shelf">
    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          CharacterReceived="OnCharacterReceived" KeyDown="OnRootKeyDown" PointerPressed="OnRootPointerPressed">
        <v:ShelfView x:Name="Shelf" />
        <v:DetailView x:Name="Detail" Visibility="Collapsed" />
        <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        <v:ImportView x:Name="ImportPage" Visibility="Collapsed" />
        <v:SetupView x:Name="SetupPage" Visibility="Collapsed" />
        <v:FreeSpaceView x:Name="FreeSpacePage" Visibility="Collapsed" />
        <v:GameModeView x:Name="GameModePage" Visibility="Collapsed" />

        <StackPanel VerticalAlignment="Bottom" Margin="16" Spacing="8">
            <!-- Notices (errors, Undo, …). On a solid backing so covers don't show through the InfoBar's
                 translucent fill. -->
            <Border x:Name="Toast" Visibility="Collapsed"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                <InfoBar x:Name="ToastBar" IsOpen="True" IsClosable="False" Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Name="ToastButton" Click="OnToastButton" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Border>

            <!-- Launch countdown (Launch → hide → return, step 2): the game, the time left as a draining bar,
                 and Keep open. Its only timer is App's countdown, which exists only while it counts. -->
            <Border x:Name="Countdown" Visibility="Collapsed" Padding="16,14,14,16"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" AutomationProperties.AccessibilityView="Raw">
                        <FontIcon Glyph="&#xF5B0;" FontSize="14" Margin="2,0,0,0"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="CountdownTitle" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="CountdownText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="KeepOpenButton" Grid.Column="2" Content="Keep open" VerticalAlignment="Center"
                            Click="OnKeepOpenClick" ToolTipService.ToolTip="Don't hide Game Shelf this time"
                            AutomationProperties.Name="Keep Game Shelf open" />
                    <ProgressBar x:Name="CountdownBar" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" Minimum="0"
                                 AutomationProperties.Name="Time until Game Shelf hides" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
