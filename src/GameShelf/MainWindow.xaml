<Window x:Class="GameShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:GameShelf.Views"
        Title="Game Shelf">
    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          CharacterReceived="OnCharacterReceived" KeyDown="OnRootKeyDown" PointerPressed="OnRootPointerPressed">
        <v:ShelfView x:Name="Shelf" />
        <v:DetailView x:Name="Detail" Visibility="Collapsed" />
        <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        <v:ImportView x:Name="ImportPage" Visibility="Collapsed" />
        <v:SetupView x:Name="SetupPage" Visibility="Collapsed" />

        <!-- In-panel launch toast: "Starting X", countdown, Keep open. Also used for notices. On a solid
             backing so covers don't show through the InfoBar's translucent fill. -->
        <Border x:Name="Toast" VerticalAlignment="Bottom" Margin="16" Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
            <InfoBar x:Name="ToastBar" IsOpen="True" IsClosable="False" Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Name="ToastButton" Click="OnToastButton" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Border>
    </Grid>
</Window>
